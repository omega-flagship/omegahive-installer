# OmegaHive host settings: a TEMPLATE with no secrets in it.
# Copy to /etc/omegahive/hive.env (owner root, group omegahive, mode 640: the service reads it, nobody else) and fill in.
# This file is read by systemd EnvironmentFile: comments must be on their own lines, never after a value.
# Never commit the filled-in copy.

# Data directory: hive.db, spaces, agents, keys. Back it up. Never commit it.
HIVE_DATA_DIR=/var/lib/omegahive
# Bind to loopback; a TLS reverse proxy (nginx/caddy) in front serves the public address.
HIVE_HOST=127.0.0.1
HIVE_PORT=8700
# The address people will use.
HIVE_PUBLIC_URL=https://YOUR.HOST
HIVE_PUBLIC_BASE=https://YOUR.HOST
# Served under /omegahive/
HIVE_BASE_PATH=omegahive

# PeTTa checkout made by deploy/RUNBOOK.md step 2.
PETTA_PATH=/opt/omegahive/PeTTa

# Google accounts that are hive admins (comma-separated).
HIVE_ADMIN_EMAILS=you@example.com
# Invite-only usernames (optional).
HIVE_SSO_USERS=
# Google sign-in. On the Google OAuth client, add this redirect URI:
#   https://YOUR.HOST/omegahive/api/auth/google/callback
HIVE_GOOGLE_CLIENT_ID=
# Secret: keep it in this file only.
HIVE_GOOGLE_CLIENT_SECRET=
HIVE_GOOGLE_REDIRECT_URI=https://YOUR.HOST/omegahive/api/auth/google/callback

# Model provider key (secret). Or paste a key in the Models view after first sign-in.
OPENROUTER_API_KEY=
HIVE_ALLOW_UNPRICED=0
HIVE_SWARM_MONTHLY_USD=500

# Mind isolation: keep at 1. On Linux this uses private namespaces + Landlock (e.g. Ubuntu 22.04 and newer).
# If the host cannot enforce it, minds are refused (fail closed). Never set 0 on a shared server.
HIVE_MIND_SANDBOX=1

# Apps: none by default. Atlas and OmegaTruth are private and are never deployed to a server.
HIVE_PLUGIN_DIRS=
HIVE_APP_PINS={}
