    "08a-upgrade-install.json": ["ok", "systemd_analyze_verified", "unit_enabled", "module_digest=892f333e..."],
    "09-upgrade.json": ["ok", "module_digest=892f333e...", "anonymous_status=401", "owner_status=200"],
    "10-quiesce-for-rollback.json": ["ok", "process_group_clean"],
    "11-restore-before-old-start.json": ["ok", "snapshot_inventory_sha256_matches_pre_upgrade", "newer_state_retained", "sqlite_integrity"],
    "11a-rollback-install.json": ["ok", "systemd_analyze_verified", "unit_enabled", "module_digest=4a5737b1..."],
