# OmegaHive host settings: a TEMPLATE with no secrets in it.
# Copy to /etc/omegahive/hive.env (owner root, group omegahive, mode 640: the service reads it, nobody else) and fill in.
# This file is read by systemd EnvironmentFile: comments must be on their own lines, never after a value.
# Never commit the filled-in copy.

# Data directory: hive.db, spaces, agents, keys. Back it up. Never commit it.
HIVE_DATA_DIR=/var/lib/omegahive
# Bind to loopback; a TLS reverse proxy (nginx/caddy) in front serves the public address.
HIVE_HOST=127.0.0.1
HIVE_PORT=8700
# The address people will use.
HIVE_PUBLIC_URL=https://YOUR.HOST
HIVE_PUBLIC_BASE=https://YOUR.HOST
# Served under /omegahive/
HIVE_BASE_PATH=omegahive

# PeTTa checkout made by deploy/RUNBOOK.md step 2.
PETTA_PATH=/opt/omegahive/PeTTa

# Where people's feedback and bug reports go (optional). Unset: the FEEDBACK_TO the release was built with, else the
# team's feedback board (https://github.com/omega-flagship/omegahive-feedback), which the page offers once the board is
# public. An https address of another GitHub repository is a board the same way; any other https address is a report
# service the hive posts reports to; none turns the direct route off. Whatever is set, a person can also copy a report
# or save it as files.
#HIVE_FEEDBACK_TO=
# A report service that asks for a token (optional): the file that holds it, readable by the hive only. Each report
# then goes with `Authorization: Bearer <the file's text>`. The token itself is never written here.
#HIVE_FEEDBACK_TOKEN_FILE=

# Google accounts that are hive admins (comma-separated).
HIVE_ADMIN_EMAILS=you@example.com
# Google accounts that may sign in as members without an invitation (comma-separated, optional).
HIVE_MEMBER_EMAILS=
# Member passwords from outside (optional): with 1, members' hive-made passwords (People page) work through the
# public address until Google sign-in below is set up. Leave 0 to use them only on this machine. Once Google sign-in
# is configured, members sign in with Google from outside, and with 1 only the test account below (for UI testers
# and agents driving a browser) keeps its password there. The operator password works only on this machine, whatever
# this flag says: from outside its login is refused.
HIVE_PUBLIC_PASSWORD=0
# The one test account (optional): set both or neither, then restart. The password: at least 10 characters, one line,
# no single quote, no trailing backslash. Never an admin's address (deploy/RUNBOOK.md, "Test accounts").
#HIVE_TEST_ACCOUNT_EMAIL=
#HIVE_TEST_ACCOUNT_PASSWORD=
# Invite-only usernames (optional).
HIVE_SSO_USERS=
# Google sign-in. On the Google OAuth client, add this redirect URI:
#   https://YOUR.HOST/omegahive/api/auth/google/callback
HIVE_GOOGLE_CLIENT_ID=
# Secret: keep it in this file only.
HIVE_GOOGLE_CLIENT_SECRET=
HIVE_GOOGLE_REDIRECT_URI=https://YOUR.HOST/omegahive/api/auth/google/callback

# Model provider key (secret). Or paste a key in the Models view after first sign-in.
OPENROUTER_API_KEY=
# ASI Cloud key (secret, optional): pays for minds on ASI Cloud's models, like the OpenRouter key above.
#ASI_API_KEY=
# Free inference (optional): a key this deploy pays an inference endpoint with, so the people the hive invited can let
# their mind think with no key of their own (deploy/RUNBOOK.md, "Free inference"). Secret: keep it in this file only.
# No page, log line or answer shows it, to admins either. Unset: no free inference.
#HIVE_FREE_INFERENCE_KEY=
# The OpenAI-compatible endpoint the key belongs to: https, or plain http to 127.0.0.1 for a stand-in; any other
# address turns free inference off. Unset: Singularity Compute's, where the team's key belongs.
#HIVE_FREE_INFERENCE_URL=https://llm.a.singularitycompute.com/v1
# The models it pays for, comma-separated; only these run on it, and the first is the one a person's mind moves to.
#HIVE_FREE_INFERENCE_MODELS=minimax/minimax-m3.1-flash
# Each person's model calls a day on it (UTC), their minds' replies in rooms and goals included. 0 turns it off.
#HIVE_FREE_INFERENCE_DAILY_CALLS=200
# The whole hive's model calls a day on it (UTC), however many people share them. 0 turns it off.
# It counts this hive's calls only: a key other deploys use too is bounded across them by its provider's limits alone.
#HIVE_FREE_INFERENCE_HIVE_DAILY_CALLS=2000
# Seconds a mind's own calls on it go on after the last message, goal claim or heartbeat it got (FREE_IDLE_WINDOW_S).
# Past that it rests: its background wakes spend none of its person's calls until someone writes. 0 turns this off.
#HIVE_FREE_INFERENCE_IDLE_WINDOW_S=1800
# 1: public visitors (anyone who signs in on a public hive without an invite) may use it too. Unset: they may not.
#HIVE_FREE_INFERENCE_VISITORS=
HIVE_ALLOW_UNPRICED=0
# The numbers below, from HIVE_START_LIMIT_MONTH_USD to HIVE_ASK_TIMEOUT_SECONDS, are the hive's settings; the code
# holds none of them (hive/core/config.py KEYS). Each key is read on its own, first layer found wins: here (the
# environment), else the deployment's JSON file that HIVE_CONFIG_FILE names (when set), else hive/config.json in the
# tree, which carries every one with the figures shown here. So a deployment file needs only the keys it changes. A
# variable set but empty (or blank) counts as unset and falls back to the files. A key in no layer, or malformed or
# out of range in the layer that has it, refuses the hive's start (exit 78) naming the key and that layer.
# The hive month limit set when the first key is added and the hive has none (change it on Limits). 0 = none.
HIVE_START_LIMIT_MONTH_USD=50
# Spending seeds (hive/API.md, "Server settings only seed a hive with no total"): each member's month, and, while the
# hive has no total, an all-time hive cap (0 = none). HIVE_SWARM_MONTHLY_USD and HIVE_PERSON_REQUEST_CEILING_USD are
# retired: set, either one only logs at startup that it does nothing.
#HIVE_MEMBER_MONTHLY_USD=50
#HIVE_BUDGET_USD=0
# The Ask's "this one looks expensive, go ahead?" question (Jon on omegahive#294, item 2). Its threshold is the lower
# of TIMES x the person's median answer over their latest MEDIANS paid answers and OVER_USD, and OVER_USD alone until
# they have FEWEST; a turn that asked waits GO_AHEAD_SECONDS for the answer.
#HIVE_ASK_EXPENSIVE_TIMES=10
#HIVE_ASK_EXPENSIVE_OVER_USD=1.0
#HIVE_ASK_EXPENSIVE_MEDIANS=20
#HIVE_ASK_EXPENSIVE_FEWEST=5
#HIVE_ASK_GO_AHEAD_SECONDS=300
# The Ask's own limits: one conductor turn's most acts, model calls, seconds, seconds waiting for one result and tokens
# per model call; one person's questions per minute and per day and reads per minute; one answer's seconds.
#HIVE_ASK_CONDUCTOR_MAX_ACTS=32
#HIVE_ASK_CONDUCTOR_MAX_MODEL_CALLS=12
#HIVE_ASK_CONDUCTOR_TURN_SECONDS=120
#HIVE_ASK_CONDUCTOR_RESULT_TIMEOUT_SECONDS=15
#HIVE_ASK_CONDUCTOR_MAX_TOKENS=1024
#HIVE_ASK_PER_MINUTE=10
#HIVE_ASK_PER_DAY=300
#HIVE_ASK_READS_PER_MINUTE=60
#HIVE_ASK_TIMEOUT_SECONDS=120

# Mind isolation: keep at 1. On Linux this uses private namespaces + Landlock (e.g. Ubuntu 22.04 and newer).
# If the host cannot enforce it, minds are refused (fail closed). Never set 0 on a shared server.
HIVE_MIND_SANDBOX=1
# The Python the Linux mind launcher runs on: an absolute path to an interpreter only root or the hive's account can
# change. Empty: the hive's own interpreter.
HIVE_SANDBOX_PYTHON=

# Apps: none by default. Atlas and OmegaTruth are private and are never deployed to a server.
HIVE_PLUGIN_DIRS=
HIVE_APP_PINS={}
