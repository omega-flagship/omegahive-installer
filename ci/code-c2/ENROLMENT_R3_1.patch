+def test_expired_enrolment_clears_only_its_pending_local_state(tmp_path, repo):
+    root = tmp_path / "expired-registration"
+    def expired(request):
+        return httpx.Response(409, json={"error": {"code": "operation_expired"}})
+    s = Service(root, OPERATOR, {"synthetic": {"path": str(repo)}}, "http://hive.invalid", httpx.MockTransport(expired))
+    try:
+        response = TestClient(create_app(s)).post("/v1/operator/register", headers={"Authorization": "Bearer " + OPERATOR},
+                                                   json={"enrol_token": "synthetic-expired-enrol-token"})
+        assert response.status_code == 409 and response.json()["error"] == "operation_expired"
+        assert not (root / "registration.operation.json").exists()
+        assert not (root / "registration.json").exists()
+    finally:
+        s.close()
+
+    operation_ids = []
+    def fresh(request):
+        if request.url.path.endswith("/register"):
+            body = json.loads(request.content)
+            operation_ids.append(body["operation_id"])
+            return httpx.Response(201, json={"service_id": "svc-fresh", "service_token": "synthetic-fresh-secret",
+                "capability_secret": "synthetic-fresh-key", "address": "http://127.0.0.1:8724",
+                "receipt": {"operation_id": body["operation_id"], "request_digest": "d" * 64,
+                            "service_id": "svc-fresh", "status": "pending"}})
+        return httpx.Response(200, json={"operation_id": operation_ids[-1], "request_digest": "d" * 64,
+                                         "service_id": "svc-fresh", "status": "active"})
+    s2 = Service(root, OPERATOR, {"synthetic": {"path": str(repo)}}, "http://hive.invalid", httpx.MockTransport(fresh))
+    try:
+        response = TestClient(create_app(s2)).post("/v1/operator/register", headers={"Authorization": "Bearer " + OPERATOR},
+                                                    json={"enrol_token": "synthetic-fresh-enrol-token"})
+        assert response.status_code == 201
+        assert len(operation_ids) == 1
+    finally:
+        s2.close()
