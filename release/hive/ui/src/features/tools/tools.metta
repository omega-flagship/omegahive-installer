; The Tools page and one tool's page, declared as atoms (screens/lib_screens.metta composes them).
; Facts the page states each time: (count tools.all) (count tools.shown) offline tool.gone, and the standard resource
; facts (screens/resourceFacts.ts: the value resource, the data resource.error); for one tool: (count tool.effects)
; (count tool.minds) tool.activatable change.failed.

(Screen tools "Tools")
(Part tools 10 header ((title "Tools") (eyebrow "What minds can think with")
  (body "Optional skills of thought. Open one to see what it does, who made it, and which minds can use it.")))
; loading, no catalogue here, or could not load (the shared fragment: orders 12, 13 and 15; there is no retry)
(Resource tools 12 ((waiting "Loading the tools") (failed "Could not load the tools")
  (part unsupported notice ((tone info) (text "This hive doesn't offer a tools catalogue yet.")))))
(Part tools 14 notice ((tone info) (text "That tool isn't in this hive any more.")))
(When tools 14 (on tool.gone))
(Part tools 16 notice ((tone warn) (text "This hive is offline, so tools that need the internet are left out.")))
(When tools 16 (on offline))
(Part tools 20 search ((label "Find a tool") (placeholder "Name, maker or what it does") (bind query)))
(When tools 20 (has tools.all))
(RolePart tools 30 collection ((source tools.shown) (title title) (summary summary) (meta (maker origin)) (open tool)
  (label "Tools")))
(When tools 30 (has tools.shown))
(Part tools 31 empty ((title "No tool matches") (body "Try another word, or clear the search.")))
(When tools 31 (has tools.all))
(When tools 31 (none tools.shown))
(Part tools 32 empty ((title "No tools yet") (body "This hive has no tools installed.")))
(When tools 32 (is resource ready))
(When tools 32 (none tools.all))

(Screen tool "A tool")
(Part tool 10 header ((title (bind tool.title)) (eyebrow "Tool") (body (bind tool.summary)) (back tools)))
(Part tool 15 notice ((tone bad) (text (bind change.problem))))
(When tool 15 (on change.failed))
(Part tool 20 chips ((label "What it may do") (source tool.effects)))
(When tool 20 (has tool.effects))
(Part tool 30 facts ((label "About it") (rows ((row "Made by" (bind tool.maker)) (row "Comes from" (bind tool.origin))
  (row "Checked" (bind tool.qualification)) (row "Checked against" (bind tool.qualification_scope))))))
(Part tool 40 section ((title "Minds that can use it")
  (body "Turn it on or off for each mind. A mind's outputs from a tool are advice; acting on them uses its own permissions.")))
(Part tool 41 toggles ((source tool.minds) (label name) (checked on) (action toggle-tool) (aria "Let {name} use {tool.title}")))
(When tool 41 (has tool.minds))
(When tool 41 (on tool.activatable))
(Part tool 42 empty ((title "No minds yet") (body "Create a mind first, then give it this tool.")))
(When tool 42 (none tool.minds))
(Part tool 43 notice ((tone info) (text "This tool can't be turned on in this hive yet.")))
(When tool 43 (off tool.activatable))
