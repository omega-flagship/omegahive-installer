; fixture story (invented; re-expresses the finale's beat shape from STORY_TIMELINE_SPEC_R1 §1)
(film f_finale (fps 60) (seconds 19.1) (seed 1907))
(beat b1 (at 0.0)  (dur 2.4) (env cosmos)  (action wake)   (intent "the mind stirs: wonder, quiet"))
(beat b2 (at 2.4)  (dur 3.0) (env bush)    (action create) (intent "making begins: growth, warmth"))
(beat b3 (at 5.4)  (dur 2.8) (env bush)    (action learn)  (intent "play: mischief"))
(beat b4 (at 8.2)  (dur 4.0) (env neonfur) (action finale) (intent "arrival: joy, release"))
(beat b5 (at 12.2) (dur 6.9) (env neonfur) (action rest)   (intent "afterglow: settle"))
(transition b1 b2 (morph material-takeover) (dur 1.2) (ease in-out))
(transition b2 b3 (morph material-takeover) (dur 1.0) (ease in-out))
(transition b3 b4 (morph material-takeover) (dur 1.0) (ease in-out))
(presence b1 listening 0.6)
(presence b4 speaking 1.0)
(event e_punch b4 (at 1.1) (kind landing-punch))
(event e_release b4 (at 2.0) (kind strand-release))
(event e_flight b4 (at 2.3) (kind butterfly-to-flamingo))
(endcard f_finale (text "Powered by Hyperon") (from 17.6))
