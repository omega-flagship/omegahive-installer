; Purpose: compose the recent creations and Artifacts link on Studio's empty canvas, and a saved picture opened there.

(Screen studio-recent "Recent creations")
(Resource studio-recent 2 ((failed "Could not list recent creations") (retry reload-creations)))
(Part studio-recent 10 section ((title "Recent creations")))
(When studio-recent 10 (is resource ready))
(When studio-recent 10 (has creations.rows))
(Part studio-recent 20 list ((source creations.rows) (label "Recent creations") (title title) (meta (label))
  (open creation) (tour design-recent)))
(When studio-recent 20 (is resource ready))
(When studio-recent 20 (has creations.rows))
(Part studio-recent 30 buttons ((items ((link "Artifacts" (bind creations.artifacts))))))

(Screen studio-picture "Picture")
(Part studio-picture 1 buttons ((items ((button "Back to recent creations" back ((variant ghost)))))))
(Resource studio-picture 3 ((waiting "Opening picture") (unsupported "This hive can't open saved pictures here.")
  (failed "Could not open the picture") (retry reload-picture)))
(Part studio-picture 15 section ((title (bind picture.title))))
(When studio-picture 15 (has picture.saved))
(Part studio-picture 20 picture ((source (bind picture.src)) (alt (bind picture.title))
  (max_height 42) (error_action picture-error)))
(When studio-picture 20 (has picture.saved))
(When studio-picture 20 (off picture.failed))
(Part studio-picture 21 notice ((tone bad) (text "This picture could not be displayed.")))
(When studio-picture 21 (on picture.failed))
