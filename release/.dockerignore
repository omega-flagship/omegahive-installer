# VCS
.git
.gitignore

# Local secrets/config
.env
.env.*
*.pem
*.key

# Python cache/artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Build/dev artifacts
*.log
*.tmp
*.swp

