; Cosmos's named parts, rest → awake → Pro (Surface cosmos-rest-r1, CANDIDATE). Loaded into the real MeTTa space with
; lib_ui and the shell's parts (experiences/parts/space.ts). Each DOM part carries its name in data-ui-part
; ("cosmos awake field" names (UiPart cosmos awake field)); parts.test.ts checks every name here is drawn, every
; UiImpl component exists at its UiSource, and every data-ui-part is registered.

; ---- rest: the real sky, dim and slow, one warm star, the faint question
(UiPart cosmos rest ω)
(UiRole (UiPart cosmos rest ω) ω)
(UiIn (UiPart cosmos rest ω) rest)
(UiIntent (UiPart cosmos rest ω) shell.omega)
(UiImpl (UiPart cosmos rest ω) three.js OmegaCore)
(UiImpl (UiPart cosmos rest ω) react CosmosRest)
(UiOwnedBy (UiPart cosmos rest ω) (UiPart shell any phase))
(UiSlot (UiPart cosmos rest ω) colour)
(UiSlot (UiPart cosmos rest ω) glow)
(UiSlot (UiPart cosmos rest ω) motion)
(UiDoc (UiPart cosmos rest ω) "The galaxy's own core gathered into one warm star. Tap it, swipe up on it, or start typing to wake.")
(UiHistory (UiPart cosmos rest ω) cosmos-rest-r1 added "2026-10-17")

(UiPart cosmos rest question)
(UiRole (UiPart cosmos rest question) question)
(UiIn (UiPart cosmos rest question) rest)
(UiIntent (UiPart cosmos rest question) shell.question)
(UiImpl (UiPart cosmos rest question) react CosmosRest)
(UiSlot (UiPart cosmos rest question) type)
(UiSlot (UiPart cosmos rest question) colour)
(UiDoc (UiPart cosmos rest question) "The faint question beneath the star, in Cosmos's wide type: the invitation into the one Ask.")
(UiHistory (UiPart cosmos rest question) cosmos-rest-r1 added "2026-10-17")

; ---- awake: the camera drifts in; the Ω is named; the field, the apps, Pro and power arrive in that order
(UiPart cosmos awake ω)
(UiRole (UiPart cosmos awake ω) ω)
(UiIn (UiPart cosmos awake ω) awake)
(UiIntent (UiPart cosmos awake ω) shell.omega)
(UiImpl (UiPart cosmos awake ω) three.js OmegaCore)
(UiImpl (UiPart cosmos awake ω) react CosmosAwake)
(UiOwnedBy (UiPart cosmos awake ω) (UiPart shell any phase))
(UiSlot (UiPart cosmos awake ω) colour)
(UiSlot (UiPart cosmos awake ω) glow)
(UiSlot (UiPart cosmos awake ω) motion)
(UiDoc (UiPart cosmos awake ω) "The star brightened and given a body. Swipe up on it for Pro; tap it to speak.")
(UiHistory (UiPart cosmos awake ω) cosmos-rest-r1 added "2026-10-17")

(UiPart cosmos awake name)
(UiRole (UiPart cosmos awake name) ω)
(UiIn (UiPart cosmos awake name) awake)
(UiIntent (UiPart cosmos awake name) shell.omega)
(UiImpl (UiPart cosmos awake name) react CosmosAwake)
(UiSlot (UiPart cosmos awake name) type)
(UiDoc (UiPart cosmos awake name) "The Ω's name (your own mind's, or Omega) and its real status: minds lit, decisions waiting.")
(UiHistory (UiPart cosmos awake name) cosmos-rest-r1 added "2026-10-17")

(UiPart cosmos awake field)
(UiRole (UiPart cosmos awake field) field)
(UiIn (UiPart cosmos awake field) awake)
(UiIntent (UiPart cosmos awake field) ask.field)
(UiImpl (UiPart cosmos awake field) react AskHost)
(UiOwnedBy (UiPart cosmos awake field) (UiPart shell any field))
(UiSlot (UiPart cosmos awake field) skin)
(UiDoc (UiPart cosmos awake field) "The shell's one Ask in Cosmos's transmission skin, floating below the Ω.")
(UiHistory (UiPart cosmos awake field) cosmos-rest-r1 added "2026-10-17")

(UiPart cosmos awake app-orbit)
(UiRole (UiPart cosmos awake app-orbit) apps)
(UiIn (UiPart cosmos awake app-orbit) awake)
(UiIntent (UiPart cosmos awake app-orbit) apps.open)
(UiImpl (UiPart cosmos awake app-orbit) three.js AppOrbit)
(UiImpl (UiPart cosmos awake app-orbit) react CosmosAwake)
(UiSlot (UiPart cosmos awake app-orbit) colour)
(UiSlot (UiPart cosmos awake app-orbit) density)
(UiSlot (UiPart cosmos awake app-orbit) material)
(UiSlot (UiPart cosmos awake app-orbit) motion)
(UiDoc (UiPart cosmos awake app-orbit) "The hive's real apps as lit crystals in a slow orbit round the Ω, each named with an Ω badge. Tap one to open it.")
(UiHistory (UiPart cosmos awake app-orbit) cosmos-rest-r1 added "2026-10-17")

(UiPart cosmos awake pro-gesture)
(UiRole (UiPart cosmos awake pro-gesture) pro-gesture)
(UiIn (UiPart cosmos awake pro-gesture) awake)
(UiIntent (UiPart cosmos awake pro-gesture) shell.pro)
(UiImpl (UiPart cosmos awake pro-gesture) react CosmosAwake)
(UiSlot (UiPart cosmos awake pro-gesture) glyph)
(UiSlot (UiPart cosmos awake pro-gesture) place)
(UiDoc (UiPart cosmos awake pro-gesture) "Pro, top right (or swipe up on the Ω): the camera flies out into the full Cosmos.")
(UiHistory (UiPart cosmos awake pro-gesture) cosmos-rest-r1 added "2026-10-17")

(UiPart cosmos awake power)
(UiRole (UiPart cosmos awake power) power)
(UiIn (UiPart cosmos awake power) awake)
(UiIntent (UiPart cosmos awake power) shell.power)
(UiImpl (UiPart cosmos awake power) react CosmosAwake)
(UiOwnedBy (UiPart cosmos awake power) (UiPart shell any phase))
(UiSlot (UiPart cosmos awake power) glyph)
(UiSlot (UiPart cosmos awake power) place)
(UiDoc (UiPart cosmos awake power) "Power, bottom left: this screen goes back to rest. Your minds keep working.")
(UiHistory (UiPart cosmos awake power) cosmos-rest-r1 added "2026-10-17")

; ---- Pro: the Cosmos as already built (unchanged), with one way back in
(UiPart cosmos pro galaxy)
(UiRole (UiPart cosmos pro galaxy) home)
(UiIn (UiPart cosmos pro galaxy) pro)
(UiImpl (UiPart cosmos pro galaxy) three.js Scene)
(UiSlot (UiPart cosmos pro galaxy) material)
(UiDoc (UiPart cosmos pro galaxy) "The seeded galaxy: swarms are star systems, minds are worlds. The same stars from rest to Pro.")
(UiHistory (UiPart cosmos pro galaxy) surface-o-q added "2026-10-06")

(UiPart cosmos pro labels)
(UiRole (UiPart cosmos pro labels) labels)
(UiIn (UiPart cosmos pro labels) pro)
(UiImpl (UiPart cosmos pro labels) react Labels)
(UiDoc (UiPart cosmos pro labels) "Names that follow the systems and worlds and never collide.")
(UiHistory (UiPart cosmos pro labels) surface-o-q added "2026-10-06")

(UiPart cosmos pro deck)
(UiRole (UiPart cosmos pro deck) apps)
(UiIn (UiPart cosmos pro deck) pro)
(UiIntent (UiPart cosmos pro deck) apps.open)
(UiImpl (UiPart cosmos pro deck) react Deck)
(UiDoc (UiPart cosmos pro deck) "The flight deck: everything in the hive, apps included, as native pages.")
(UiHistory (UiPart cosmos pro deck) surface-o-q added "2026-10-06")

(UiPart cosmos pro panels)
(UiRole (UiPart cosmos pro panels) panels)
(UiIn (UiPart cosmos pro panels) pro)
(UiImpl (UiPart cosmos pro panels) react MindPanel)
(UiImpl (UiPart cosmos pro panels) react SystemPanel)
(UiDoc (UiPart cosmos pro panels) "A world's or a system's transmission panel.")
(UiHistory (UiPart cosmos pro panels) surface-o-q added "2026-10-06")

(UiPart cosmos pro field)
(UiRole (UiPart cosmos pro field) field)
(UiIn (UiPart cosmos pro field) pro)
(UiIntent (UiPart cosmos pro field) ask.field)
(UiImpl (UiPart cosmos pro field) react AskHost)
(UiOwnedBy (UiPart cosmos pro field) (UiPart shell any field))
(UiSlot (UiPart cosmos pro field) skin)
(UiDoc (UiPart cosmos pro field) "The same one Ask, in its transmission console.")
(UiHistory (UiPart cosmos pro field) cosmos-rest-r1 added "2026-10-17")

(UiPart cosmos pro back)
(UiRole (UiPart cosmos pro back) pro-gesture)
(UiIn (UiPart cosmos pro back) pro)
(UiIntent (UiPart cosmos pro back) shell.back)
(UiImpl (UiPart cosmos pro back) react Controls)
(UiSlot (UiPart cosmos pro back) glyph)
(UiDoc (UiPart cosmos pro back) "Back to the Ω (or Esc in the galaxy): the camera flies back in.")
(UiHistory (UiPart cosmos pro back) cosmos-rest-r1 added "2026-10-17")

; ---- the transitions, as Cosmos draws them (one camera controller; reduced motion cuts)
(UiImpl (UiMove cosmos wake) three.js CameraRig)
(UiImpl (UiMove cosmos settle) three.js CameraRig)
(UiImpl (UiMove cosmos fly-out) three.js CameraRig)
(UiImpl (UiMove cosmos fly-in) three.js CameraRig)

(UiSource OmegaCore "experiences/cosmos/Scene.tsx")
(UiSource AppOrbit "experiences/cosmos/Scene.tsx")
(UiSource CameraRig "experiences/cosmos/Scene.tsx")
(UiSource Scene "experiences/cosmos/Scene.tsx")
(UiSource CosmosRest "experiences/cosmos/phases.tsx")
(UiSource CosmosAwake "experiences/cosmos/phases.tsx")
(UiSource Labels "experiences/cosmos/Labels.tsx")
(UiSource Deck "experiences/cosmos/Deck.tsx")
(UiSource MindPanel "experiences/cosmos/Panels.tsx")
(UiSource SystemPanel "experiences/cosmos/Panels.tsx")
(UiSource Controls "experiences/cosmos/index.tsx")

(UiPart cosmos rest apps)
(UiRole (UiPart cosmos rest apps) apps-entry)
(UiIn (UiPart cosmos rest apps) rest)
(UiIntent (UiPart cosmos rest apps) shell.apps)
(UiImpl (UiPart cosmos rest apps) react CosmosRest)
(UiDoc (UiPart cosmos rest apps) "Apps first in every look (Jon 2 Nov): one visible press at rest wakes straight into the apps, the first app focused.")
