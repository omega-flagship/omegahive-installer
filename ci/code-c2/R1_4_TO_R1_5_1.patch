+        'scope': 'cooperative retained transcript; supplied artifact bindings; historical inspection only',
+        'run_id': run['id'], 'workspace_id': run['workspace_id'], 'context': context,
+        'output_digest': run['output_digest'], 'receipt_digest': run['receipt_digest'],
+        'evaluator_digest': run['evaluator_digest'], 'helper_digest': run['symbolic_session']['helper_digest'],
+        'runtime_id': run['symbolic_session']['runtime_id'],
+        'submitted_controls_binding_digest': _digest([{k: record[k] for k in
+            ('id', 'sequence', 'kind', 'input_bytes', 'input_digest', 'actor')} for record in controls]),
+        'evidence_origin': 'caller-provided run/control/receipt/output; provenance unattested by this pure reader',
+        'record_origin_authenticated': False, 'workspace_custody_checked_here': False,
+        'supplied_content_hashes_match': True, 'authorization_checked_here': False,
+        'stdout_author_authenticated': False, 'native_integrity_verified': False,
+        'reductions_verified': False, 'execution_effects_verified': False, 'history_complete': False,
+        'current_engine_admission_verified': False, 'engine_invoked_by_reader': False,
+        'replay_performed': False, 'submitted_inputs': len(requests),
+        'reported_consumed_controls': len(consumed), 'control_consumption_is_execution': False,
+        'correlated_response_frames': len(responses), 'missing_response_count': len(missing),
+        'first_missing_input_sequences': missing[:16], 'incomplete_reasons': sorted(reasons),
+        'traces': list(traces.values()), 'observations': page, 'after': after,
+        'next': after+len(page), 'eof': after+len(page) == len(ordered),
+        'unique_reported_observations': len(ordered),
+        'observation_meaning': 'deduplicated reported samples keyed by trace and input sequence; not reductions or advances'}
+    if len(_encoded(report)) > 65536:
+        _fail('report_limit', 'typed readback exceeds the 65536-byte response bound')
+    return report
