diff --git a/omegacode/disposable_copy_policy.py b/omegacode/disposable_copy_policy.py
new file mode 100644
index 0000000..092d61e
--- /dev/null
+++ b/omegacode/disposable_copy_policy.py
@@ -0,0 +1,48 @@
+"""Purpose: classify owner-declared disposable app writes without permitting file deletion or truncation."""
+from .common import MAX_FILE, canonical, digest, safe_path
+
+
+def configured_policy(service, config):
+    """Keep automatic copying disabled unless the owner names a repository and exact file ceiling."""
+    if config is None:
+        return None
+    if not isinstance(config, dict) or set(config) != {'kind', 'repository_id', 'paths'} \
+            or config['kind'] != 'disposable-app-files-v1' \
+            or config['repository_id'] not in service.repositories:
+        raise ValueError('exact disposable app copy policy required')
+    paths = config['paths']
+    if not isinstance(paths, list) or not paths or any(type(p) is not str for p in paths) \
+            or len(set(paths)) != len(paths):
+        raise ValueError('distinct disposable app files required')
+    for path in paths:
+        safe_path(path)
+    permitted = frozenset(paths)
+    repository = config['repository_id']
+
+    def classify(binding, edits):
+        answer = {'binding': binding, 'classification': 'unresolved'}
+        workspace = service.workspace(binding['workspace_id'])
+        if workspace['repository_id'] != repository \
+                or (workspace['generation'], workspace['tree_digest']) != (binding['generation'], binding['tree_digest']) \
+                or binding['edits_digest'] != digest(canonical(edits)) \
+                or not isinstance(edits, list) or not edits:
+            return answer
+        files = service.manifest(workspace, binding['tree_digest'])['files']
+        seen = set()
+        # Time: n edits + b bytes encoded, n = len(edits), b = total UTF-8 content size.
+        for edit in edits:
+            if not isinstance(edit, dict) or set(edit) != {'path', 'expected_digest', 'content'}:
+                return answer
+            path, content = edit['path'], edit['content']
+            if type(path) is not str or path not in permitted or path in seen or type(content) is not str:
+                return answer
+            seen.add(path)
+            old = files.get(path)
+            if edit['expected_digest'] != (old['digest'] if old else None):
+                return answer
+            size = len(content.encode('utf-8'))
+            if not content.strip() or size > MAX_FILE or (old and size < old['size']):
+                return answer
+        return {'binding': binding, 'classification': 'non_deleting'}
+
+    return classify
