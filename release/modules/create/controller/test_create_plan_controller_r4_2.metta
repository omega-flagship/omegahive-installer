!(test (pstat widget (append (two-built) ((o 11 dispatched (v2 review (widget w1 design-review))) (o 12 review-pass (widget w1 design-review rev2 (render s1)))))) reviewed)
; the whole hive: an open capability, any mind or team offering it
(= (open-g) ((Piece research (Assignee open deep-research) (doc) () (notes.md))))
(= (rf-doc) ((ReviewFor doc doc-review none)))
(= (open-red) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (open-g) () (Needs no-design detect (rf-doc) ())))
               (o 3 dispatched (op2 detect-tests none)) (o 4 tests-detected (op2 suite1))
               (o 5 dispatched (r0 run-checks base)) (o 6 check-fail (r0 base (notes.md)))))
!(test (na (open-red)) (do (start-piece research (Assignee open deep-research))))
!(test (last-rc (append (open-red) ((o 7 piece-started (research t1 hive-swarm (hive-wide deep-research)))))) accepted)
; another hive: the resolution must name that hive
(= (hive-g) ((Piece render (Assignee hive farm-hive render-farm) (media) () (film.mp4))))
(= (hive-red) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (hive-g) () (Needs no-design detect (rf-media) ())))
               (o 3 dispatched (op2 detect-tests none)) (o 4 tests-detected (op2 suite1))
               (o 5 dispatched (r0 run-checks base)) (o 6 check-fail (r0 base (film.mp4)))))
