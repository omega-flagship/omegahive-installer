  "cases": ["full", "refusal", "timeout", "sigterm", "sigkill"],
  "pending_after_success": ["production_host_guard", "authenticated_enrollment_and_revocation", "live_proved_relay", "workbench_first_app", "independent_hive_restart", "hyperon_worker", "arm_linux"]
