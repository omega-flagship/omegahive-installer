+def test_operator_registration_busy_returns_retry_after(service, monkeypatch):
+    import omegacode.registration as registration
+
+    monkeypatch.setattr(registration, "_REGISTRATION_LOCK_TIMEOUT_SECONDS", 0.05)
+    entered = threading.Event()
+    release = threading.Event()
+
+    def hold_lock():
+        with registration._registration_lock(service.store.root):
+            entered.set()
+            release.wait(timeout=2)
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        held = pool.submit(hold_lock)
+        assert entered.wait(timeout=1)
+        try:
+            client = TestClient(create_app(service))
+            response = client.post("/v1/operator/register",
+                headers={"Authorization": "Bearer " + OPERATOR},
+                json={"enrol_token": "synthetic-enrol-token-123456"})
+        finally:
+            release.set()
+            held.result(timeout=2)
+
+    assert response.status_code == 503
+    assert response.headers["retry-after"] == "35"
+    assert response.json()["error"] == "registration_busy"
+    assert response.json()["details"] == {"retry_after_seconds": 35}
+    assert "wait at least 35 seconds" in response.json()["message"]
+
