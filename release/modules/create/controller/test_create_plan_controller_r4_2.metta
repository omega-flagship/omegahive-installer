!(import! &self create_plan_controller_r4_2)

; R4.2 tests: all 228 R4.1 tests carried (Ctx Caps gains the retry budget, 2 here, as R4.1's shared fix-rounds value),
; then part 4: every lost operation kind is bounded.
; R4.1 tests. Part 1 carries every R4.0 test with only the observation shapes adapted:
;   piece-started gains the resolved assignee; piece-ready / piece-blocked name the task or route-fix op (review B2);
;   the four team review kinds become review-pass / review-fail (p cand review-kind reviewer evidence), the kind
;   checked against ReviewFor atoms; dispatched review / route-fix subjects name the review kind / the repairer;
;   question-withdrawn names who withdraws (S3); deploy-approved names the form confirmed; start, review and
;   route-fix actions carry the assignee selector or review kind the host needs.
; Part 2 adds the generalisation tests; part 3 turns every review probe into a passing negative test.

; Ctx: plan pl1, epoch e1, person jon, authors (dot planner), caps (2 repairs per piece, 2 fix rounds), budget 2
(= (rf) ((ReviewFor code review none) (ReviewFor design design-review render)))
(= (ctx) (Ctx pl1 e1 jon (dot planner) (Caps 2 2 2) 2 review-required (rf)))
(= (o $id $kind $f) (O $id $kind pl1 e1 $f))
(= (st $log) (replay (ctx) (start-state) $log))
(= (ph $log) (phase-of (st $log)))
(= (rc $log) (receipts (ctx) (start-state) $log))
(= (na $log) (next-action (ctx) (st $log)))
(= (final-of $xs) (if (== (cdr-atom $xs) ()) (car-atom $xs) (final-of (cdr-atom $xs))))
(= (last-rc $log) (final-of (rc $log)))
(= (pstat $p $log) (status-of $p (st $log)))
(= (ctx-w) (Ctx pl1 e1 jon (dot planner) (Caps 2 2 2) 2 review-waivable (rf)))
(= (ctx-l1) (Ctx pl1 e1 jon (dot planner) (Caps 2 2 2) 1 review-required (rf)))
(= (ctx-c1) (Ctx pl1 e1 jon (dot planner) (Caps 1 1 1) 2 review-required (rf)))
(= (as-studio) (Assignee team studio))
(= (as-code) (Assignee team code))
(= (nd) (Needs no-design author () ()))

; Slice-1 demo: "make me a small web page that shows X". Studio: index.html, style.css (kind design). Code: app.js
; (kind code; its wiring waits on Studio's layout because the plan says so). The acceptance test comes first.
(= (web) ((Piece page (as-studio) (design) () (index.html)) (Piece style (as-studio) (design) () (style.css)) (Piece app (as-code) (code) (page) (app.js))))
(= (plan1) (Plan ref1 1 sha256:a1 none))
(= (planned-log $unk) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (web) $unk (nd)))))
(= (tests-log) ((o 3 dispatched (op2 author-tests ref1)) (o 4 tests-authored (op2 suite1))))
(= (red-log) ((o 5 dispatched (r0 run-checks base)) (o 6 check-fail (r0 base (app.test.js)))))
(= (to-red) (append (planned-log ()) (append (tests-log) (red-log))))
(= (studio-log) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (style t2 studio-b (team studio)))
                 (o 9 piece-ready (page t1 c1)) (o 10 piece-ready (style t2 c2))
                 (o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review rev1 (render shot1)))
                 (o 13 dispatched (v2 review (style c2 design-review))) (o 14 review-pass (style c2 design-review rev1 (render shot2)))
                 (o 15 dispatched (i1 integrate (page c1))) (o 16 integrated (i1 page c1 k1))
                 (o 17 dispatched (i2 integrate (style c2))) (o 18 integrated (i2 style c2 k2))))
(= (code-log) ((o 19 piece-started (app t3 coder-a (team code))) (o 20 piece-ready (app t3 c3))
               (o 21 dispatched (v3 review (app c3 review))) (o 22 review-pass (app c3 review rev1 none))
               (o 23 dispatched (i3 integrate (app c3))) (o 24 integrated (i3 app c3 k3))))
(= (to-checking) (append (to-red) (append (studio-log) (code-log))))
(= (to-ready) (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-pass (r1 k3))
                                     (o 27 dispatched (p1 preview k3)) (o 28 preview-deployed (p1 k3 url1)))))
(= (to-deployed) (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 deployed (d1)))))

; ==== PART 1: R4.0 carried ====
; ---- the happy path, step by step ----
!(test (next-action (ctx) (start-state)) (think make-the-plan))
!(test (na ((o 1 plan-started (op1)))) (rest awaiting-planner))
!(test (ph (planned-log ())) planned)
!(test (na (planned-log ())) (think author-acceptance-tests))
!(test (ph (append (planned-log ()) (tests-log))) testing-authored)
!(test (na (append (planned-log ()) (tests-log))) (do (run-checks base)))
!(test (ph (to-red)) building)
!(test (na (to-red)) (do (start-piece page (Assignee team studio))))
!(test (na (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio)))))) (do (start-piece style (Assignee team studio))))
!(test (na (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (style t2 studio-b (team studio)))))) (rest awaiting-pieces))
!(test (na (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (style t2 studio-b (team studio))) (o 9 piece-ready (page t1 c1)))))
       (do (request-review page c1 design-review)))
!(test (na (append (to-red) (append (studio-log) ((o 19 piece-started (app t3 coder-a (team code))) (o 20 piece-ready (app t3 c3)))))) (do (request-review app c3 review)))
!(test (ph (append (to-red) (append (studio-log) ((o 19 piece-started (app t3 coder-a (team code))) (o 20 piece-ready (app t3 c3))
          (o 21 dispatched (v3 review (app c3 review))) (o 22 review-pass (app c3 review rev1 none)))))) integrating)
!(test (ph (to-checking)) checking)
!(test (na (to-checking)) (do (run-checks k3)))
!(test (na (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-pass (r1 k3))))) (do (preview-deploy k3)))
!(test (ph (to-ready)) ready-to-deploy)
!(test (na (to-ready)) (tell confirm-deploy pl1))
!(test (na (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy))))) (do (deploy d1)))
!(test (ph (to-deployed)) deployed)
!(test (na (to-deployed)) (rest done))
!(test (needs-model (na (planned-log ()))) True)
!(test (needs-model (na (to-red))) False)

; ---- the plan graph: OmegaPlanner's validation, in MeTTa ----
(= (plan-with $g) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) $g () (nd)))))
!(test (last-rc (plan-with ((Piece a (as-code) (code) (b) (a.js)) (Piece b (as-code) (code) (a) (b.js))))) (rejected dependency_cycle))
!(test (last-rc (plan-with ((Piece a (as-code) (code) (zz) (a.js))))) (rejected unknown_dependency))
!(test (last-rc (plan-with ((Piece a (as-code) (code) () (a.js)) (Piece a (as-studio) (design) () (b.css))))) (rejected duplicate_step))
!(test (last-rc (plan-with ((Piece a (as-code) (code) () (a.js)) (Piece b (as-studio) (design) () (a.js))))) (rejected file_owned_twice))
; R4.0's "unknown team" is now any team; a malformed selector is the invalid step
!(test (last-rc (plan-with ((Piece a (Assignee marketing x) (code) () (a.js))))) (rejected invalid_step))
!(test (last-rc (plan-with ())) (rejected step_count_limit))
!(test (last-rc ((o 1 plan-started (op1)) (o 2 planned (op1 (Plan ref1 2 sha256:a1 sha256:z) (web) () (nd))))) (rejected stale_revision))
!(test (ph (append (plan-with ()) ((o 3 plan-failed (op1))))) claimed)
!(test (na (append (plan-with ()) ((o 3 plan-failed (op1))))) (think make-the-plan))

; ---- design: optional for a plan with no design pieces; design pieces carry it otherwise ----
(= (code-only $need) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) ((Piece app (as-code) (code) () (app.js))) () (Needs $need author () ())))))
!(test (last-rc ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (web) () (Needs design author () ()))))) (rejected design-pieces-carry-the-design))
!(test (na (code-only design)) (think make-the-design))
!(test (ph (append (code-only design) ((o 3 dispatched (dz design ref1))))) designing)
!(test (na (append (code-only design) ((o 3 dispatched (dz design ref1)) (o 4 designed (dz des1))))) (think author-acceptance-tests))
!(test (last-rc (append (code-only design) ((o 3 dispatched (op2 author-tests ref1))))) (rejected tests-not-due))
!(test (na (code-only no-design)) (think author-acceptance-tests))
!(test (last-rc (append (code-only no-design) ((o 3 dispatched (dz design ref1))))) (rejected design-not-due))
(= (detect-log) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (web) () (Needs no-design detect () ())))))
!(test (na (detect-log)) (do (detect-tests)))
!(test (ph (append (detect-log) ((o 3 dispatched (op2 detect-tests none)) (o 4 tests-detected (op2 suite0))))) testing-authored)
!(test (last-rc (append (detect-log) ((o 3 dispatched (op2 detect-tests none)) (o 4 tests-authored (op2 suite0))))) (rejected not-the-open-test-request))

; ---- tests first: no piece before the suite, and the scaffold must be red ----
!(test (last-rc (append (planned-log ()) ((o 3 piece-started (page t1 studio-a (team studio)))))) (rejected piece-not-startable))
!(test (last-rc (append (planned-log ()) (append (tests-log) ((o 5 piece-started (page t1 studio-a (team studio))))))) (rejected piece-not-startable))
(= (green-base) (append (planned-log ()) (append (tests-log) ((o 5 dispatched (r0 run-checks base)) (o 6 check-pass (r0 base))))))
!(test (ph (green-base)) blocked)
!(test (na (green-base)) (tell ask-person (blocked tests-not-red)))
!(test (na (append (green-base) ((o 7 question-asked (qb blocked)) (o 8 answered (qb jon ans-b))))) (think author-acceptance-tests))

; ---- cross-assignee dependency ordering and parallelism under the budget ----
!(test (may-start (ctx) (st (to-red))) (page style))
!(test (last-rc (append (to-red) ((o 7 piece-started (app t3 coder-a (team code)))))) (rejected piece-not-startable))
!(test (may-start (ctx) (st (append (to-red) (studio-log)))) (app))
!(test (may-start (ctx) (st (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 9 piece-ready (page t1 c1))
          (o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review rev1 (render shot1)))
          (o 15 dispatched (i1 integrate (page c1))) (o 16 integrated (i1 page c1 k1)))))) (style app))
(= (par-graph) ((Piece page (as-studio) (design) () (index.html)) (Piece app (as-code) (code) () (app.js)) (Piece docs (as-code) (code) () (README.md))))
(= (par-red-g $g) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) $g () (nd)))
              (o 3 dispatched (op2 author-tests ref1)) (o 4 tests-authored (op2 suite1))
              (o 5 dispatched (r0 run-checks base)) (o 6 check-fail (r0 base (app.js)))))
(= (par-red) (par-red-g (par-graph)))
!(test (may-start (ctx) (st (par-red))) (page app))
!(test (rc (append (par-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (app t2 coder-a (team code))) (o 9 piece-started (docs t3 coder-b (team code))))))
       (accepted accepted accepted accepted accepted accepted accepted accepted (rejected lease-full)))
!(test (active-count (st (append (par-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (app t2 coder-a (team code))) (o 9 piece-started (docs t3 coder-b (team code))))))) 2)
!(test (last-rc (append (par-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (app t2 coder-a (team code))) (o 9 piece-ready (app t2 c1)) (o 10 piece-started (docs t3 coder-b (team code)))))) accepted)
!(test (final-of (receipts (ctx-l1) (start-state) (append (par-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (app t2 coder-a (team code))))))) (rejected lease-full))
!(test (may-start (ctx-l1) (start-state)) ())

; ---- questions hold only dependent work ----
(= (q-log) (append (planned-log ((q1 (piece page)))) (append (tests-log) (red-log))))
!(test (na (planned-log ((q1 (piece page))))) (tell ask-person q1))
(= (q-asked) (append (planned-log ((q1 (piece page)))) (append ((o 30 question-asked (q1 (piece page)))) (append (tests-log) (red-log)))))
!(test (ph (q-asked)) building)
!(test (may-start (ctx) (st (q-asked))) (style))
!(test (last-rc (append (q-asked) ((o 7 piece-started (page t1 studio-a (team studio)))))) (rejected awaiting-answer))
!(test (na (append (q-asked) ((o 8 piece-started (style t2 studio-b (team studio))) (o 10 piece-ready (style t2 c2))
          (o 13 dispatched (v2 review (style c2 design-review))) (o 14 review-pass (style c2 design-review rev1 (render shot2)))
          (o 17 dispatched (i2 integrate (style c2))) (o 18 integrated (i2 style c2 k2))))) (rest awaiting-answer))
!(test (may-start (ctx) (st (append (q-asked) ((o 31 answered (q1 jon ans1)))))) (page style))
!(test (last-rc (append (q-asked) ((o 31 answered (q1 eve ans1))))) (rejected not-the-person))
!(test (last-rc (append (q-asked) ((o 31 answered (q1 planner ans1))))) (rejected not-the-person))
!(test (last-rc (append (q-log) ((o 31 answered (q1 jon ans1))))) (rejected not-an-open-question))
!(test (last-rc (append (to-red) ((o 31 question-asked (q9 plan)) (o 7 piece-started (page t1 studio-a (team studio)))))) (rejected awaiting-answer))
!(test (last-rc (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 31 question-asked (q9 plan)) (o 9 piece-ready (page t1 c1))))) accepted)

; ---- red -> fix -> green; failures route to the owning piece ----
(= (fail-style) (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 (style.css))))))
!(test (ph (fail-style)) fixing)
!(test (pstat style (fail-style)) fixing)
!(test (na (fail-style)) (do (route-fix style r1 (Assignee team studio))))
(= (fixed) (append (fail-style) ((o 40 dispatched (f1 route-fix (style fixer-s))) (o 41 piece-ready (style f1 c4))
            (o 42 dispatched (v4 review (style c4 design-review))) (o 43 review-pass (style c4 design-review rev1 (render shot4)))
            (o 44 dispatched (i4 integrate (style c4))) (o 45 integrated (i4 style c4 k4)))))
!(test (ph (fixed)) checking)
!(test (na (fixed)) (do (run-checks k4)))
!(test (ph (append (fixed) ((o 46 dispatched (r2 run-checks k4)) (o 47 check-pass (r2 k4))))) previewing)
!(test (last-rc (append (fail-style) ((o 40 dispatched (f1 route-fix (style fixer-s))) (o 41 piece-ready (style f1 c2))))) (rejected candidate-unchanged))
!(test (pstat app (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 (app.js)))))) fixing)
!(test (map-atom (sv (st (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 (app.js index.html)))))) pieces) $r (index-atom $r 2))
       (fixing integrated fixing))
!(test (sv (st (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 (server.py)))))) why) (unrouted-failure (server.py)))
(= (dr-fail) (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 9 piece-ready (page t1 c1))
            (o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-fail (page c1 design-review rev1 (render shot1))))))
!(test (pstat page (dr-fail)) fixing)
!(test (na (dr-fail)) (do (route-fix page v1 (Assignee team studio))))
!(test (ph (append (dr-fail) ((o 13 dispatched (f1 route-fix (page fixer-p))) (o 14 piece-ready (page f1 c5))))) building)
!(test (pstat app (append (to-red) (append (studio-log) ((o 19 piece-started (app t3 coder-a (team code))) (o 20 piece-ready (app t3 c3))
          (o 21 dispatched (v3 review (app c3 review))) (o 22 review-fail (app c3 review rev1 none)))))) fixing)

; ---- review: kinds from atoms, evidence, independent reviewers ----
(= (page-built) (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 9 piece-ready (page t1 c1)))))
!(test (last-rc (append (page-built) ((o 11 dispatched (v1 review (page c1 review)))))) (rejected review-not-due))
; R4.0's wrong-review-kind: a result for a review kind that was never requested
!(test (last-rc (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 review rev1 none))))) (rejected review-not-requested))
!(test (last-rc (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review rev1 none))))) (rejected review-needs-evidence))
!(test (last-rc (append (page-built) ((o 12 review-pass (page c1 design-review rev1 (render shot1)))))) (rejected review-not-requested))
!(test (last-rc (append (page-built) ((o 8 piece-started (style t2 coder-z (team studio))) (o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review coder-z (render shot1))))))
       (rejected reviewer-not-independent))
!(test (last-rc (append (to-red) (append (studio-log) ((o 19 piece-started (app t3 coder-a (team code))) (o 20 piece-ready (app t3 c3))
          (o 21 dispatched (v3 review (app c3 review))) (o 22 review-pass (app c3 review studio-a none))))))
       (rejected reviewer-not-independent))
!(test (last-rc (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review planner (render shot1)))))) (rejected reviewer-not-independent))
!(test (last-rc (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review jon (render shot1)))))) (rejected reviewer-not-independent))
!(test (last-rc (append (page-built) ((o 11 dispatched (i1 integrate (page c1)))))) (rejected integrate-not-due))
(= (unavail) (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-unavailable (page c1 design-review)))))
!(test (ph (unavail)) blocked)
!(test (phase-of (replay (ctx-w) (start-state) (unavail))) building)
!(test (status-of page (replay (ctx-w) (start-state) (unavail))) reviewed)
(= (waived-ready) (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-started (style t2 studio-b (team studio)))
                 (o 9 piece-ready (page t1 c1)) (o 10 piece-ready (style t2 c2))
                 (o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-unavailable (page c1 design-review))
                 (o 13 dispatched (v2 review (style c2 design-review))) (o 14 review-pass (style c2 design-review rev1 (render shot2)))
                 (o 15 dispatched (i1 integrate (page c1))) (o 16 integrated (i1 page c1 k1))
                 (o 17 dispatched (i2 integrate (style c2))) (o 18 integrated (i2 style c2 k2))
                 (o 19 piece-started (app t3 coder-a (team code))) (o 20 piece-ready (app t3 c3))
                 (o 21 dispatched (v3 review (app c3 review))) (o 22 review-pass (app c3 review rev1 none))
                 (o 23 dispatched (i3 integrate (app c3))) (o 24 integrated (i3 app c3 k3))
                 (o 25 dispatched (r1 run-checks k3)) (o 26 check-pass (r1 k3))
                 (o 27 dispatched (p1 preview k3)) (o 28 preview-deployed (p1 k3 url1)))))
!(test (next-action (ctx-w) (replay (ctx-w) (start-state) (waived-ready))) (tell confirm-unreviewed-deploy pl1))

; ---- caps: past a cap the plan blocks and asks the person ----
(= (c1-st $log) (replay (ctx-c1) (start-state) $log))
(= (c1-rc $log) (final-of (receipts (ctx-c1) (start-state) $log)))
(= (fail2) (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 (style.css)))
            (o 40 dispatched (f1 route-fix (style fixer-s))) (o 41 piece-ready (style f1 c4))
            (o 42 dispatched (v4 review (style c4 design-review))) (o 43 review-pass (style c4 design-review rev1 (render shot4)))
            (o 44 dispatched (i4 integrate (style c4))) (o 45 integrated (i4 style c4 k4))
            (o 46 dispatched (r2 run-checks k4)) (o 47 check-fail (r2 k4 (app.js))))))
!(test (phase-of (c1-st (fail2))) blocked)
!(test (sv (c1-st (fail2)) why) (cap-exceeded fix-rounds))
!(test (ph (fail2)) fixing)
!(test (next-action (ctx-c1) (c1-st (fail2))) (tell ask-person (blocked (cap-exceeded fix-rounds))))
(= (dr-fail2) (append (dr-fail) ((o 13 dispatched (f1 route-fix (page fixer-p))) (o 14 piece-ready (page f1 c5))
               (o 15 dispatched (v5 review (page c5 design-review))) (o 16 review-fail (page c5 design-review rev1 (render shot5))))))
!(test (sv (c1-st (dr-fail2)) why) (cap-exceeded piece-repairs))
!(test (ph (dr-fail2)) building)
!(test (c1-rc (append (fail2) ((o 48 dispatched (f2 route-fix (app fixer-a)))))) (rejected hold-kept))
!(test (phase-of (c1-st (append (fail2) ((o 48 unknown (zz9)) (o 49 reconciled (zz9)))))) blocked)
!(test (c1-rc (append (fail2) ((o 48 question-asked (qb blocked)) (o 49 question-withdrawn (qb jon))))) (rejected hold-needs-the-persons-answer))
!(test (c1-rc (append (fail2) ((o 48 question-asked (qb blocked)) (o 49 answered (qb eve ans))))) (rejected not-the-person))
!(test (next-action (ctx-c1) (c1-st (append (fail2) ((o 48 question-asked (qb blocked)) (o 49 answered (qb jon ans)))))) (do (route-fix app r2 (Assignee team code))))
!(test (sv (st (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 piece-blocked (page t1))))) why) (piece-blocked page))

; ---- the deploy: only the person's go produces deployed ----
!(test (last-rc (append (to-ready) ((o 29 deployed (d1))))) (rejected deploy-not-approved-by-the-person))
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (d1 eve confirm-deploy))))) (rejected not-the-person))
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (d1 planner confirm-deploy))))) (rejected not-the-person))
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 deployed (d9))))) (rejected deploy-not-approved-by-the-person))
!(test (last-rc (append (to-checking) ((o 29 deploy-approved (d1 jon confirm-deploy))))) (rejected not-ready-to-deploy))
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (r1 jon confirm-deploy))))) (rejected operation-id-reused))
!(test (last-rc (append (to-ready) ((o 29 dispatched (d1 deploy k3))))) (rejected not-dispatchable))
!(test (na (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 deploy-refused (d1))))) (tell confirm-deploy pl1))
!(test (last-rc (append (to-ready) ((o 29 question-asked (q7 deploy)) (o 30 deploy-approved (d1 jon confirm-deploy))))) (rejected awaiting-answer))
!(test (na (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 question-asked (q7 deploy))))) (do (reconcile d1)))
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 question-asked (q7 deploy)) (o 31 deployed (d1))))) (rejected deploy-not-approved-by-the-person))
!(test (na (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-pass (r1 k3)) (o 27 question-asked (q7 deploy))))) (do (preview-deploy k3)))

; ---- replay, idempotency, wrong / late / forged observations ----
!(test (== (st (append (to-deployed) (to-deployed))) (st (to-deployed))) True)
!(test (last-rc (append (to-red) ((o 6 check-fail (r0 base (app.test.js)))))) duplicate)
