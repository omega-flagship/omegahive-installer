+def inspect_trace(output: bytes, run: dict, controls, receipt_bytes: bytes, *, after=0, limit=100):
+    """Inspect immutable supplied evidence; page unique *reported* observations.
+
+    Raises TraceReadError on corrupt bindings/unsupported schemas. Incompleteness
+    is explicit, and no result authenticates the author of stdout or native work.
+    Caller remains responsible for obtaining all inputs under existing authority.
