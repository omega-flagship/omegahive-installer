+                    or frame['step_commands'] != list(STEP_OPS)
+                    or type(frame['atom_count']) is not int or frame['atom_count'] != 0
+                    or frame['snapshot_representation'] != 'rendered-atom-multiset-v1'
+                    or frame['persistence'] != 'resident process only; no automatic replay'):
