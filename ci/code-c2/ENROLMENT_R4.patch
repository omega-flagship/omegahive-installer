+def test_enrolment_process_crash_after_ack_recovers_from_status(tmp_path, repo):
+    root = tmp_path / "registration-post-ack-crash"
+    state = {"operation_id": None, "active": False}
+    def first_transport(request):
+        if request.url.path.endswith("/register"):
+            state["operation_id"] = json.loads(request.content)["operation_id"]
+            return httpx.Response(201, json={"service_id": "svc-post-ack", "service_token": "synthetic-post-ack-token",
+                "capability_secret": "synthetic-post-ack-key", "address": "http://127.0.0.1:8724",
+                "receipt": {"operation_id": state["operation_id"], "request_digest": "1" * 64,
+                            "service_id": "svc-post-ack", "status": "pending"}})
+        if request.url.path.endswith("/ack"):
+            state["active"] = True
+            raise KeyboardInterrupt("synthetic process crash after host ack commits")
+        raise AssertionError(request.url)
+    first = Service(root, OPERATOR, {"synthetic": {"path": str(repo)}}, "http://hive.invalid", httpx.MockTransport(first_transport))
