; ==== PART 2: R4.1 generalisation ====
; a piece assigned to one specialist mind: only that mind may take it
(= (mind-g) ((Piece score (Assignee mind composer-7) (media) () (score.mid)) (Piece app (as-code) (code) () (app.js))))
(= (rf-media) ((ReviewFor media listening-review recording)))
(= (mind-red) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (mind-g) () (Needs no-design author (rf-media) ())))
               (o 3 dispatched (op2 author-tests ref1)) (o 4 tests-authored (op2 suite1))
               (o 5 dispatched (r0 run-checks base)) (o 6 check-fail (r0 base (app.js)))))
