!(test (na (append (ua) ((o 8 question-asked (qa (piece render))) (o 9 answered (qa jon use-farm-b))))) (do (start-piece render (Assignee hive farm-hive render-farm))))
!(test (last-rc (append (to-ready) ((o 29 assignee-unavailable (app))))) (rejected assignee-not-due))
; a per-assignee cap from the plan: two code pieces under (AssigneeCap code 1), budget 2
(= (cap-red) (par-red-cap))
(= (par-red-cap) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (par-graph) () (Needs no-design author () ((AssigneeCap (Assignee team code) 1)))))
