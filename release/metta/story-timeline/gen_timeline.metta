; gen_timeline (prototype): story atoms -> timeline records. MeTTa decides; the renderer draws.
(= (r6 $x) (* 1.0 (/ (round-math (* $x 1000000)) 1000000)))
(= (sum-list $xs) (foldl-atom $xs 0 $acc $x (+ $acc $x)))
(= (first-or $xs $d) (if (== $xs ()) $d (car-atom $xs)))

(= (beat-start $b) (match &self (beat $b (at $a) $d $e $ac $i) $a))
(= (beat-dur $b) (match &self (beat $b $a (dur $d) $e $ac $i) $d))
(= (beat-env $b) (match &self (beat $b $a $d (env $e) $ac $i) $e))
(= (beat-end $b) (r6 (+ (beat-start $b) (beat-dur $b))))
(= (all-beats) (collapse (match &self (beat $b $a $d $e $ac $i) $b)))
(= (next-of $b) (let $end (beat-end $b) (first-or (collapse (match &self (beat $n (at $end) $d $e $ac $i) $n)) endcard)))
(= (prev-of $b) (let $s (beat-start $b) (first-or (collapse (match &self (beat $p $a (dur $d) $e $ac $i) (if (== (r6 (+ (beat-start $p) $d)) $s) $p (empty)))) none)))
(= (rate-of $b) (let $e (beat-env $b) (first-or (collapse (match &self (look-env $e $r) $r)) 1.0)))

; material clock: beat-local (lt-mode local) so an edit to one beat cannot move another beat's frames
(= (lt-a $b) (lt-a-mode (first-or (collapse (match &self (lt-mode $m) $m)) local) $b))
(= (lt-a-mode local $b) (let $p (prev-of $b) (if (== $p none) 0.0 (if (same-material $p $b) (lt-end $p) 0.0))))
(= (same-material $p $b) (and (== (beat-env $p) (beat-env $b)) (== (collapse (match &self (transition $p $b $m $d $ez) t)) ())))
(= (lt-end $b) (r6 (+ (lt-a $b) (* (rate-of $b) (beat-dur $b)))))
(= (lt-a-mode cumulative $b) (let $s (beat-start $b) (r6 (sum-list (collapse (match &self (beat $x (at $a) (dur $d) $e $ac $i) (if (< $a $s) (* $d (rate-of $x)) 0)))))))

; presence: closed-form exponential approach (k 4.0) from the value carried in at the beat start
(= (pres-target $b) (first-or (collapse (match &self (presence $b $m $v) $v)) 0.0))
(= (pres-mode $b) (first-or (collapse (match &self (presence $b $m $v) $m)) idle))
(= (p-start $b) (let $p (prev-of $b) (if (== $p none) 0.0 (p-end $p))))
(= (p-end $b) (let* (($t (pres-target $b)) ($p0 (p-start $b)) ($d (beat-dur $b)))
                (r6 (+ $t (* (- $p0 $t) (pow-math 2.718281828459045 (* -4.0 $d)))))))

(= (emit-seg $b) (match &self (beat $b (at $a) (dur $d) (env $e) (action $ac) (intent $i))
   (println! (seg $b $a (beat-end $b) $e $ac $i (next-of $b) (lt-a $b) (rate-of $b) (p-start $b) (pres-target $b) (pres-mode $b)))))
(= (emit-trans) (match &self (transition $x $y (morph $m) (dur $d) (ease $ez))
   (let $c (beat-start $y) (println! (trans $x $y (r6 (- $c (/ $d 2))) (r6 (+ $c (/ $d 2))) (beat-env $x) (beat-env $y) $m $ez)))))
(= (emit-events) (match &self (event $id $b (at $r) (kind $k)) (println! (event-at $id (r6 (+ (beat-start $b) $r)) $k $b))))

; checks (hard; a failed check blocks the render job)
(= (chk-tiling) (let* (($bs (all-beats))
                       ($starts (collapse (match &self (beat $x (at $a) $d $e $ac $i) (if (== (prev-of $x) none) $x (empty)))))
                       ($ends (collapse (match &self (beat $x $a $d $e $ac $i) (if (== (next-of $x) endcard) $x (empty)))))
                       ($secs (match &self (film $f $fps (seconds $s) $sd) $s)))
     (if (and (== (size-atom $starts) 1) (and (== (size-atom $ends) 1) (and (== (beat-start (car-atom $starts)) 0.0) (== (beat-end (car-atom $ends)) $secs)))) ok fail)))
(= (chk-events) (if (== (collapse (match &self (event $id $b (at $r) $k) (if (> $r (beat-dur $b)) $id (empty)))) ()) ok fail))
(= (chk-trans) (if (== (collapse (match &self (transition $x $y $m $d $ez) (if (== (next-of $x) $y) (empty) $x))) ()) ok fail))
(= (chk-envs) (if (== (collapse (match &self (beat $b $a $d (env $e) $ac $i) (if (== (collapse (match &self (look-env $e $r) $r)) ()) $e (empty)))) ()) ok fail))
(= (chk-endcard) (if (== (collapse (match &self (endcard $f $t $fr) $f)) ()) fail ok))

!(match &self (film $f (fps $fps) (seconds $s) (seed $sd)) (println! (timeline-film $f $fps $s $sd)))
!(let $_ (collapse (match &self (beat $b $a $d $e $ac $i) (emit-seg $b))) done)
!(let $_ (collapse (emit-trans)) done)
!(let $_ (collapse (emit-events)) done)
!(match &self (endcard $f (text $t) (from $fr)) (println! (endcard $t $fr)))
!(println! (check tiling (chk-tiling)))
!(println! (check events-inside-beats (chk-events)))
!(println! (check transitions-adjacent (chk-trans)))
!(println! (check envs-known (chk-envs)))
!(println! (check endcard-present (chk-endcard)))
