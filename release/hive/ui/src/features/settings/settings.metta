; The Settings page, declared as atoms (screens/lib_screens.metta composes them). One screen: how this hive is set up,
; the panels the page still draws itself (islands: where this hive runs, the Google connector, registered services, the
; Ask audit; each decides for itself whether this hive offers it), then the pages that own the rest.
;
; Facts the page states each time:
;   loading: the standard resource facts (screens/resourceFacts.ts: the value resource, resource.stale, the data
;            resource.error)
;   the hive: hive.supervised (count hive.base_paths)
;   sign-in: signin.family_google signin.hive_google
;   operator password: password.from_env password.confirming password.fresh
;   disk: disk.low
;   apps: (count apps.homes) (count apps.sandbox_apps) (count apps.sandbox_runtimes) (count apps.local_only_swarms)
;   links: (count settings.links)

(Screen settings "Settings")
(Part settings 1 header ((title "Settings") (eyebrow "This hive")
  (body "How this hive is set up, with no secrets shown. The one change made here is a new operator password; everything else links to the page that owns it.")))

; ---------- reading the settings: the shared fragment, orders 5 to 12
(Resource settings 5 ((waiting "Reading this hive's settings…") (unsupported "This hive does not report its settings yet.")
  (forbidden "Only a hive admin can see how the hive is set up.") (failed-title "Could not load settings")
  (stale "Could not refresh the settings. Showing the last loaded data.") (stale-reason "Why they could not refresh")
  (retry retry)))

; ---------- the hive
(Part settings 20 section ((title "Hive")))
(When settings 20 (is resource ready))
(Part settings 21 facts ((label "Hive") (rows ((row "Name" (bind hive.name)) (row "Running build" (bind hive.build))
  (row "Started" (bind hive.started))))))
(When settings 21 (is resource ready))
(Part settings 22 facts ((label "Updates") (rows ((row "Restarts itself on update" "Yes (supervised)")))))
(When settings 22 (is resource ready))
(When settings 22 (on hive.supervised))
(Part settings 23 facts ((label "Updates") (rows ((row "Restarts itself on update" "No: restart it from its host")))))
(When settings 23 (is resource ready))
(When settings 23 (off hive.supervised))
(Part settings 24 facts ((label "Public paths") (rows ((row "Public paths" (bind hive.base_paths))))))
(When settings 24 (is resource ready))
(When settings 24 (has hive.base_paths))

; ---------- sign-in
(Part settings 30 section ((title "Sign-in")))
(When settings 30 (is resource ready))
(Part settings 31 facts ((label "Family sign-in") (rows ((row "Family Google sign-in" "On: the everyday way in")))))
(When settings 31 (is resource ready))
(When settings 31 (on signin.family_google))
(Part settings 32 facts ((label "Family sign-in") (rows ((row "Family Google sign-in" "Off")))))
(When settings 32 (is resource ready))
(When settings 32 (off signin.family_google))
(Part settings 33 facts ((label "Hive sign-in") (rows ((row "Hive's own Google sign-in" "Google client set")
  (row "Redirect for invite links" (bind signin.callback_path))))))
(When settings 33 (is resource ready))
(When settings 33 (on signin.hive_google))
(Part settings 34 facts ((label "Hive sign-in") (rows ((row "Hive's own Google sign-in" "Not configured")
  (row "Redirect for invite links" (bind signin.callback_path))))))
(When settings 34 (is resource ready))
(When settings 34 (off signin.hive_google))
(Part settings 35 notice ((tone info)
  (text "Invite links sign people in with the hive's own Google sign-in. Register the redirect above as an authorised redirect in Google Cloud, or invitations cannot sign anyone in.")))
(When settings 35 (is resource ready))

; ---------- the operator password: set on the host, or rotated here (ask, confirm, then shown once)
(Part settings 40 section ((title "Operator password")))
(When settings 40 (is resource ready))
(Part settings 41 notice ((tone info) (text "Set by HIVE_ADMIN_PASSWORD on the host; change it there.")))
(When settings 41 (is resource ready))
(When settings 41 (on password.from_env))
(Part settings 42 actions ((items ((action "Rotate password…" ask-rotate)))))
(When settings 42 (is resource ready))
(When settings 42 (off password.from_env))
(When settings 42 (off password.fresh))
(When settings 42 (off password.confirming))
(Part settings 43 confirm ((text "Make a new password and sign out every password session?")
  (yes "Rotate now") (yes_action rotate) (no "Cancel") (no_action cancel-rotate)))
(When settings 43 (is resource ready))
(When settings 43 (off password.from_env))
(When settings 43 (off password.fresh))
(When settings 43 (on password.confirming))
(Part settings 44 reveal ((label "New password. Shown once: copy it now.") (value (bind password.fresh))
  (copy copy-password) (hide hide-password)
  (note "Every password sign-in has ended. Family and Google sign-ins are unaffected.")))
(When settings 44 (is resource ready))
(When settings 44 (off password.from_env))
(When settings 44 (on password.fresh))

; ---------- disk
(Part settings 50 section ((title "Disk")))
(When settings 50 (is resource ready))
(Part settings 51 facts ((label "Disk") (rows ((row "Free on this Mac" (bind disk.free)) (row "Hive data" (bind disk.hive_data))))))
(When settings 51 (is resource ready))
(Part settings 52 notice ((tone warn) (text "Free space on this Mac is low.")))
(When settings 52 (is resource ready))
(When settings 52 (on disk.low))

; ---------- apps and isolation (set on the host)
(Part settings 60 section ((title "Apps and isolation")
  (body "These are set on the host (hive-local/env). Changing them takes a restart.")))
(When settings 60 (is resource ready))
(Part settings 61 chips ((label "Where apps open") (source apps.homes)))
(When settings 61 (is resource ready))
(When settings 61 (has apps.homes))
(Part settings 62 facts ((label "Where apps open") (rows ((row "Where apps open" "Each app opens where it was last used")))))
(When settings 62 (is resource ready))
(When settings 62 (none apps.homes))
(Part settings 63 facts ((label "Sandboxed tool apps") (rows ((row "Sandboxed tool apps" (bind apps.sandbox_apps))))))
(When settings 63 (is resource ready))
(When settings 63 (has apps.sandbox_apps))
(Part settings 64 facts ((label "Sandboxed tool apps") (rows ((row "Sandboxed tool apps" "None")))))
(When settings 64 (is resource ready))
(When settings 64 (none apps.sandbox_apps))
(Part settings 65 facts ((label "Sandbox runtimes") (rows ((row "Sandbox runtimes" (bind apps.sandbox_runtimes))))))
(When settings 65 (is resource ready))
(When settings 65 (has apps.sandbox_runtimes))
(Part settings 66 facts ((label "Sandbox runtimes") (rows ((row "Sandbox runtimes" "None")))))
(When settings 66 (is resource ready))
(When settings 66 (none apps.sandbox_runtimes))
(Part settings 67 facts ((label "Local-only swarms") (rows ((row "Local-only swarms" (bind apps.local_only_swarms))))))
(When settings 67 (is resource ready))
(When settings 67 (has apps.local_only_swarms))
(Part settings 68 facts ((label "Local-only swarms") (rows ((row "Local-only swarms" "None")))))
(When settings 68 (is resource ready))
(When settings 68 (none apps.local_only_swarms))
(Part settings 69 notice ((tone info) (text "Local-only swarms: their minds' model calls never leave this machine.")))
(When settings 69 (is resource ready))

; ---------- parts the page still draws itself (islands), in this order, whatever the settings say
(Part settings 70 island ((name hive-placement)))
(Part settings 71 island ((name google-connector)))
(Part settings 72 island ((name registered-services)))
(Part settings 73 island ((name ask-audit)))

; ---------- the pages that own the rest; the look decides list or cards
(RolePart settings 80 collection ((source settings.links) (title label) (summary body) (icon icon) (open link) (label "More settings")))
(When settings 80 (has settings.links))
