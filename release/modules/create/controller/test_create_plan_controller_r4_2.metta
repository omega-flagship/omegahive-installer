!(test (last-rc (append (mind-red) ((o 7 piece-started (score t1 composer-7 (mind composer-7)))))) accepted)
!(test (last-rc (append (mind-red) ((o 7 piece-started (score t1 someone-else (mind someone-else)))))) (rejected assignee-mismatch))
!(test (pc-resolved (piece-rec score (st (append (mind-red) ((o 7 piece-started (score t1 composer-7 (mind composer-7)))))))) (mind composer-7))
