!(test (final-of (receipts (ctx-w) (start-state) (append (waived-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)))))) (rejected not-the-form-the-person-was-shown))
!(test (phase-of (replay (ctx-w) (start-state) (append (waived-ready) ((o 29 deploy-approved (d1 jon confirm-unreviewed-deploy)) (o 30 deployed (d1)))))) deployed)

; ==== PART 3: the R4.0 review probes, each a passing negative test ====
; B1: never zero results; non-ground and malformed observations are refused
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (d1 $who confirm-deploy))))) (rejected not-ground))
!(test (last-rc (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review $rv (render shot1)))))) (rejected not-ground))
!(test (last-rc (append (q-asked) ((o 31 answered (q1 $p ans1))))) (rejected not-ground))
!(test (last-rc (append (to-red) ((O 7 $k pl1 e1 (page t1 studio-a (team studio)))))) (rejected not-ground))
!(test (last-rc (append (to-red) ((o 7 piece-started (page $t studio-a (team studio)))))) (rejected not-ground))
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 deployed ($x))))) (rejected not-ground))
!(test (last-rc (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-pass ($r k3))))) (rejected not-ground))
!(test (last-rc (append (to-red) ((O 7 piece-started $pl $ep (page t1 studio-a (team studio)))))) (rejected not-ground))
!(test (rc ((O 1 $k pl1 e1 (op1)))) ((rejected not-ground)))
!(test (last-rc (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 app.js))))) (rejected malformed-fields))
!(test (size-atom (collapse (st (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 app.js))))))) 1)
!(test (last-rc ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (web) junk (nd))))) (rejected invalid_unknowns))
!(test (last-rc ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (web) ((q1 plan) (q2 (piece zz))) (nd))))) (rejected invalid_unknowns))
!(test (last-rc (plan-with ((Piece a (as-code) (code) b (a.js)) (Piece b (as-code) (code) () (b.js))))) (rejected invalid_step))
!(test (last-rc (plan-with ((Piece a (as-code) (code) () a.js)))) (rejected invalid_step))
!(test (last-rc (plan-with ((Piece a (as-code) (code) (a) (a.js))))) (rejected dependency_cycle))
!(test (last-rc (plan-with ((Piece a (as-code) (code) () (a.js) extra)))) (rejected invalid_step))
!(test (last-rc (plan-with ((Piece a (as-code) (code) () (a.js a.js))))) (rejected file_owned_twice))
!(test (last-rc (plan-with ((Piece (x y) (code) (code) () (a.js))))) (rejected invalid_step))
!(test (last-rc (plan-with ((Piece 1 (as-code) (code) () (a.js)) (Piece 1 (as-code) (code) () (b.js))))) (rejected duplicate_step))
!(test (last-rc (plan-with (foo))) (rejected invalid_step))
!(test (last-rc (plan-with foo)) (rejected invalid_plan_object))
!(test (last-rc (plan-with ((Piece a (as-studio) (design) () ())))) (rejected invalid_step))
!(test (last-rc (plan-with ((Piece a (as-code) () () (a.js))))) (rejected invalid_step))
!(test (last-rc (append (to-red) ((o 7 cancelled (x))))) (rejected malformed-fields))
!(test (last-rc (append (to-red) ((Junk an observation)))) (rejected malformed-observation))
; B2: a late piece-ready from a superseded task is refused; the current task's result is taken
(= (s4) (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 8 unknown (t1)) (o 9 reconciled (t1)) (o 10 piece-started (page t2 studio-c (team studio))))))
!(test (last-rc (append (s4) ((o 11 piece-ready (page t1 cLATE))))) (rejected not-a-running-piece))
!(test (pc-cand (piece-rec page (st (append (s4) ((o 11 piece-ready (page t1 cLATE)) (o 12 piece-ready (page t2 c2))))))) c2)
!(test (last-rc (append (s4) ((o 11 piece-blocked (page t1))))) (rejected not-a-running-piece))
; S3: only the person withdraws a question
!(test (last-rc (append (planned-log ((q1 (piece page)))) (append (tests-log) (append (red-log) ((o 30 question-withdrawn (q1 planner))))))) (rejected not-the-person))
!(test (last-rc (append (planned-log ((q1 (piece page)))) (append (tests-log) (append (red-log) ((o 30 question-withdrawn (q1 planner)) (o 31 piece-started (page t1 studio-a (team studio)))))))) (rejected awaiting-answer))
!(test (last-rc (append (planned-log ((q1 (piece page)))) (append (tests-log) (append (red-log) ((o 30 question-withdrawn (q1 jon)) (o 31 piece-started (page t1 studio-a (team studio)))))))) accepted)
; S4: a deploy of unknown fate is settled only by its own readback; never a second go on a plain reconcile
(= (s3) (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 unknown (d1)))))
!(test (na (s3)) (do (reconcile d1)))
!(test (last-rc (append (s3) ((o 31 reconciled (d1))))) (rejected deploy-needs-its-own-readback))
!(test (last-rc (append (s3) ((o 31 reconciled (d1)) (o 32 deploy-approved (d2 jon confirm-deploy))))) (rejected unresolved-effect-first))
!(test (ph (append (s3) ((o 31 deployed-confirmed (d1 rcpt1))))) deployed)
!(test (na (append (s3) ((o 31 deployed-confirmed (d1 rcpt1))))) (rest done))
!(test (na (append (s3) ((o 31 reconciled-not-deployed (d1))))) (tell confirm-deploy pl1))
!(test (ph (append (s3) ((o 31 reconciled-not-deployed (d1)) (o 32 deploy-approved (d2 jon confirm-deploy)) (o 33 deployed (d2))))) deployed)
!(test (last-rc (append (s3) ((o 31 reconciled-not-deployed (d1)) (o 32 deployed (d1))))) (rejected deploy-not-approved-by-the-person))
!(test (last-rc (append (to-ready) ((o 29 deployed-confirmed (d1 rcpt1))))) (rejected not-an-unresolved-deploy))
!(test (last-rc (append (s3) ((o 31 deployed-confirmed (d9 rcpt1))))) (rejected not-an-unresolved-deploy))
; a go cleared by a question after it is also settled by its own readback
!(test (ph (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 question-asked (q7 deploy)) (o 31 deployed-confirmed (d1 rcpt1))))) deployed)
; S5: any open question holds the go, and a piece question asked after the go clears it
!(test (na (append (to-ready) ((o 29 question-asked (qp (piece app)))))) (rest awaiting-answer))
!(test (last-rc (append (to-ready) ((o 29 question-asked (qp (piece app))) (o 30 deploy-approved (d1 jon confirm-deploy))))) (rejected awaiting-answer))
!(test (last-rc (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 question-asked (qp (piece app))) (o 31 deployed (d1))))) (rejected deploy-not-approved-by-the-person))
; nits: checkpoint ids are never reused; review dispatch respects question holds; lost operations are bounded
!(test (last-rc (append (to-red) ((o 7 piece-started (page t1 studio-a (team studio))) (o 9 piece-ready (page t1 c1))
   (o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review rev1 (render shot1)))
   (o 15 dispatched (i1 integrate (page c1))) (o 16 integrated (i1 page c1 k1))
   (o 8 piece-started (style t2 studio-b (team studio))) (o 10 piece-ready (style t2 c2))
   (o 13 dispatched (v2 review (style c2 design-review))) (o 14 review-pass (style c2 design-review rev1 (render shot2)))
   (o 17 dispatched (i2 integrate (style c2))) (o 18 integrated (i2 style c2 k1))))) (rejected checkpoint-not-new))
!(test (last-rc (append (page-built) ((o 10 question-asked (qx (piece page))) (o 11 dispatched (v1 review (page c1 design-review)))))) (rejected awaiting-answer))
(= (lost $n $r) ((o (+ 100 $n) dispatched ($r run-checks k3)) (o (+ 200 $n) check-unknown ($r)) (o (+ 300 $n) reconciled ($r))))
!(test (ph (append (to-checking) (append (lost 1 rl1) (lost 2 rl2)))) checking)
!(test (sv (st (append (to-checking) (append (lost 1 rl1) (append (lost 2 rl2) (lost 3 rl3))))) why) (cap-exceeded lost-operations))
; an older checkpoint id (not just the current one) is never reused
!(test (last-rc (append (to-red) (append (studio-log) ((o 19 piece-started (app t3 coder-a (team code))) (o 20 piece-ready (app t3 c3))
          (o 21 dispatched (v3 review (app c3 review))) (o 22 review-pass (app c3 review rev1 none))
          (o 23 dispatched (i3 integrate (app c3))) (o 24 integrated (i3 app c3 k1)))))) (rejected checkpoint-not-new))
; B1 to the leaf: a kinds field that is a symbol, and a grounded-but-non-symbol id expression
!(test (last-rc (plan-with ((Piece a (as-code) code () (a.js))))) (rejected invalid_step))
!(test (size-atom (collapse (st (plan-with ((Piece a (as-code) code () (a.js))))))) 1)
!(test (last-rc (plan-with ((Piece (Pg x) (as-code) (code) () (a.js))))) (rejected invalid_step))

; ==== PART 4 (R4.2): every lost operation, of any kind, spends the plan's retry budget ====
; with a budget of 0 retries, one lost operation of each kind blocks and asks the person
(= (ctx-r0) (Ctx pl1 e1 jon (dot planner) (Caps 2 2 0) 2 review-required (rf)))
(= (in-r0 $log) (replay (ctx-r0) (start-state) $log))
(= (lost-blocks $log) (if (== (phase-of (in-r0 $log)) blocked) (sv (in-r0 $log) why) (phase-of (in-r0 $log))))
(= (lose $op) ((o lost-u unknown ($op)) (o lost-r reconciled ($op))))
!(test (lost-blocks (append ((o 1 plan-started (op1))) (lose op1))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (code-only design) (append ((o 3 dispatched (dz design ref1))) (lose dz)))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (planned-log ()) (append ((o 3 dispatched (op2 author-tests ref1))) (lose op2)))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (detect-log) (append ((o 3 dispatched (op2 detect-tests none))) (lose op2)))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (planned-log ()) (append (tests-log) (append ((o 5 dispatched (r0 run-checks base))) (lose r0))))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (to-red) (append ((o 7 piece-started (page t1 studio-a (team studio)))) (lose t1)))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (fail-style) (append ((o 40 dispatched (f1 route-fix (style fixer-s)))) (lose f1)))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (page-built) (append ((o 11 dispatched (v1 review (page c1 design-review)))) (lose v1)))) (cap-exceeded lost-operations))
(= (page-reviewed) (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 12 review-pass (page c1 design-review rev1 (render shot1))))))
!(test (lost-blocks (append (page-reviewed) (append ((o 15 dispatched (i1 integrate (page c1)))) (lose i1)))) (cap-exceeded lost-operations))
(= (to-preview) (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-pass (r1 k3)))))
!(test (lost-blocks (append (to-preview) (append ((o 27 dispatched (p1 preview k3))) (lose p1)))) (cap-exceeded lost-operations))
!(test (lost-blocks (append (to-red) (lose x9))) (cap-exceeded lost-operations))
; a check of unknown fate, reconciled, is a lost run-checks too
!(test (lost-blocks (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-unknown (r1)) (o 27 reconciled (r1))))) (cap-exceeded lost-operations))
; the block holds what it held: the lost integrate's piece is still reviewed, and the person's answer resumes it
(= (int-lost3) (append (page-reviewed) ((o 15 dispatched (i1 integrate (page c1))) (o 151 unknown (i1)) (o 152 reconciled (i1))
                                       (o 16 dispatched (i2 integrate (page c1))) (o 161 unknown (i2)) (o 162 reconciled (i2))
                                       (o 17 dispatched (i3 integrate (page c1))) (o 171 unknown (i3)) (o 172 reconciled (i3)))))
!(test (ph (int-lost3)) blocked)
!(test (sv (st (int-lost3)) why) (cap-exceeded lost-operations))
!(test (pstat page (int-lost3)) reviewed)
!(test (last-rc (append (int-lost3) ((o 18 dispatched (i4 integrate (page c1)))))) (rejected hold-kept))
!(test (na (int-lost3)) (tell ask-person (blocked (cap-exceeded lost-operations))))
!(test (na (append (int-lost3) ((o 19 question-asked (qb blocked)) (o 20 answered (qb jon go-on))))) (do (integrate page c1)))
; two losses stay within a budget of 2
!(test (ph (append (page-reviewed) ((o 15 dispatched (i1 integrate (page c1))) (o 151 unknown (i1)) (o 152 reconciled (i1))
                                    (o 16 dispatched (i2 integrate (page c1))) (o 161 unknown (i2)) (o 162 reconciled (i2))))) building)
; review and preview loops are bounded the same way under the default budget
!(test (ph (append (page-built) ((o 11 dispatched (v1 review (page c1 design-review))) (o 111 unknown (v1)) (o 112 reconciled (v1))
                                 (o 12 dispatched (v2 review (page c1 design-review))) (o 121 unknown (v2)) (o 122 reconciled (v2))
                                 (o 13 dispatched (v3 review (page c1 design-review))) (o 131 unknown (v3)) (o 132 reconciled (v3))))) blocked)
!(test (ph (append (to-preview) ((o 27 dispatched (p1 preview k3)) (o 271 unknown (p1)) (o 272 reconciled (p1))
                                 (o 28 dispatched (p2 preview k3)) (o 281 preview-failed (p2))
                                 (o 29 dispatched (p3 preview k3)) (o 291 unknown (p3)) (o 292 reconciled (p3))))) blocked)
; a deploy is never retried by the reducer: its readback needs no budget, and a new deploy needs the person's fresh go
!(test (phase-of (in-r0 (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 unknown (d1)) (o 31 reconciled-not-deployed (d1)))))) ready-to-deploy)
!(test (next-action (ctx-r0) (in-r0 (append (to-ready) ((o 29 deploy-approved (d1 jon confirm-deploy)) (o 30 unknown (d1)) (o 31 reconciled-not-deployed (d1)))))) (tell confirm-deploy pl1))
; the retry budget is its own Ctx field: fix rounds 2, retries 0
!(test (ph (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 (style.css)))))) fixing)
!(test (phase-of (in-r0 (append (to-checking) ((o 25 dispatched (r1 run-checks k3)) (o 26 check-fail (r1 k3 (style.css))))))) fixing)
