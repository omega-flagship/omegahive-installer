; The People page, one person on it, and the hive operator, declared as atoms (screens/lib_screens.metta composes
; them). The page composes each person for their own facts, and the people screen stacks them under "In this hive".
;
; Facts the page states each time:
;   people: the resource facts (value resource, resource.stale; data resource.error), people.loaded
;           google.ready can.invite can.add_member can.withdraw viewer.admin passwords.on invite.fresh invite.copied
;           password.shown password.copied password.ended; the value password.reason (added or reset);
;           (count invites.pending)
;   people-person: person.self person.disabled person.google person.password viewer.admin passwords.on can.update
;           can.clear_google can.reset_password can.remove_password; the value person.role (admin or member)

(Screen people "People")

; ---------- reading the people list (only admins may): the shared resource states (lib_screens.metta Resource),
; drawn with this page's own icons and words
(Resource people 1 ((waiting "Loading people") (unsupported "This hive or the demo does not list people.") (unsupported-icon ban)
  (part forbidden empty ((icon shield) (title "Admins only") (body "Ask an admin of this hive to invite someone.")))
  (part failed empty ((icon alert) (title "Could not load people") (body (bind resource.error))))
  (retry retry)))

; ---------- inviting someone: the form is the page's own (an island); what it cannot do yet is said here
(Part people 20 island ((name invite-form)))
(When people 20 (on people.loaded))
(Part people 21 notice ((tone warn) (text "Google sign-in is not set up yet; the link will not work until it is.")))
(When people 21 (on people.loaded))
(When people 21 (off google.ready))
(Part people 22 notice ((tone warn) (text "Inviting is not available here (this hive or the demo does not send invitations).")))
(When people 22 (on people.loaded))
(When people 22 (off can.invite))
; the link just made, shown only now: copy it, or email it from the person's own mail app
(Part people 25 reveal ((label (bind invite.title)) (value (bind invite.link)) (copy copy-link) (copy_label "Copy link")
  (hide dismiss-link) (hide_label "Dismiss") (note "Send this link. It is shown only now; create a new invitation if it is lost.")))
(When people 25 (on people.loaded))
(When people 25 (on invite.fresh))
(When people 25 (off invite.copied))
(Part people 26 reveal ((label (bind invite.title)) (value (bind invite.link)) (copy copy-link) (copy_label "Copied")
  (hide dismiss-link) (hide_label "Dismiss") (note "Send this link. It is shown only now; create a new invitation if it is lost.")))
(When people 26 (on people.loaded))
(When people 26 (on invite.fresh))
(When people 26 (on invite.copied))
(Part people 27 actions ((items ((action "Email it" email-invite)))))
(When people 27 (on people.loaded))
(When people 27 (on invite.fresh))

; ---------- adding a member with a password: admins, while Google sign-in is not set up
(Part people 30 island ((name member-form)))
(When people 30 (on people.loaded))
(When people 30 (on viewer.admin))
(When people 30 (on passwords.on))
(When people 30 (on can.add_member))
(When people 30 (off google.ready))

; ---------- a member's password, shown this once
(Part people 40 reveal ((label (bind password.added_title)) (value (bind password.value)) (copy copy-password)
  (copy_label "Copy password") (hide hide-password) (hide_label "Dismiss") (alert yes) (note (bind password.note))))
(When people 40 (on people.loaded))
(When people 40 (on password.shown))
(When people 40 (is password.reason added))
(When people 40 (off password.copied))
(Part people 41 reveal ((label (bind password.added_title)) (value (bind password.value)) (copy copy-password)
  (copy_label "Copied") (hide hide-password) (hide_label "Dismiss") (alert yes) (note (bind password.note))))
(When people 41 (on people.loaded))
(When people 41 (on password.shown))
(When people 41 (is password.reason added))
(When people 41 (on password.copied))
(Part people 42 reveal ((label (bind password.reset_title)) (value (bind password.value)) (copy copy-password)
  (copy_label "Copy password") (hide hide-password) (hide_label "Dismiss") (alert yes) (note (bind password.note))))
(When people 42 (on people.loaded))
(When people 42 (on password.shown))
(When people 42 (is password.reason reset))
(When people 42 (off password.ended))
(When people 42 (off password.copied))
(Part people 43 reveal ((label (bind password.reset_title)) (value (bind password.value)) (copy copy-password)
  (copy_label "Copied") (hide hide-password) (hide_label "Dismiss") (alert yes) (note (bind password.note))))
(When people 43 (on people.loaded))
(When people 43 (on password.shown))
(When people 43 (is password.reason reset))
(When people 43 (off password.ended))
(When people 43 (on password.copied))
(Part people 44 reveal ((label (bind password.reset_title)) (value (bind password.value)) (copy copy-password)
  (copy_label "Copy password") (hide hide-password) (hide_label "Dismiss") (alert yes) (note (bind password.note_ended))))
(When people 44 (on people.loaded))
(When people 44 (on password.shown))
(When people 44 (is password.reason reset))
(When people 44 (on password.ended))
(When people 44 (off password.copied))
(Part people 45 reveal ((label (bind password.reset_title)) (value (bind password.value)) (copy copy-password)
  (copy_label "Copied") (hide hide-password) (hide_label "Dismiss") (alert yes) (note (bind password.note_ended))))
(When people 45 (on people.loaded))
(When people 45 (on password.shown))
(When people 45 (is password.reason reset))
(When people 45 (on password.ended))
(When people 45 (on password.copied))
(Part people 46 note ((text "It will not be shown again. Copy it now and give it to them privately; the hive keeps only a hash of it.")))
(When people 46 (on people.loaded))
(When people 46 (on password.shown))

; ---------- invitations waiting to be accepted; withdrawn ones are gone from the list
(Part people 50 section ((title "Waiting to accept")))
(When people 50 (on people.loaded))
(When people 50 (has invites.pending))
(Part people 51 entries ((source invites.pending) (icon icon) (title title) (meta meta) (action withdraw) (open withdraw)
  (label "Waiting to accept")))
(When people 51 (on people.loaded))
(When people 51 (has invites.pending))
(When people 51 (on can.withdraw))
(Part people 52 entries ((source invites.pending) (icon icon) (title title) (meta meta) (label "Waiting to accept")))
(When people 52 (on people.loaded))
(When people 52 (has invites.pending))
(When people 52 (off can.withdraw))

; ---------- who is in this hive: the operator first, then each person as their own composed screen
(Part people 60 section ((title "In this hive")))
(When people 60 (on people.loaded))
(Part people 61 stack ((source people.rows) (frame inset) (label "In this hive")))
(When people 61 (on people.loaded))
(Part people 62 note ((text "Members use the hive. Admins also invite people, set spending limits and manage the hive's default keys. Removing someone signs them out everywhere at once.")))
(When people 62 (on people.loaded))

(Screen people-operator "The hive operator")
(Part people-operator 10 line ((title "Hive operator") (orb operator.hue) (badge "Admin")))
(Part people-operator 20 note ((text "Signs in on this hive's own machine")))

(Screen people-person "A person")
; the name after their orb (dimmed once removed), "you" for the person signed in, and the role in words wherever it
; cannot be changed here
(Part people-person 10 line ((title (bind person.name)) (meta (bind person.you)) (orb person.hue) (status person.status)
  (dim person.disabled) (badge "Removed")))
(When people-person 10 (on person.disabled))
(Part people-person 11 line ((title (bind person.name)) (meta (bind person.you)) (orb person.hue) (status person.status)
  (dim person.disabled) (badge (bind person.role_word))))
(When people-person 11 (off person.disabled))
(When people-person 11 (any ((on person.self) (off can.update))))
(Part people-person 12 line ((title (bind person.name)) (orb person.hue) (status person.status) (dim person.disabled)))
(When people-person 12 (on can.update))
(When people-person 12 (none-of ((on person.disabled) (on person.self))))

; their email and when they were last seen; how they sign in
(Part people-person 20 note ((text (bind person.sub))))
(Part people-person 21 note ((text "Signs in with Google · Signs in with a hive password")))
(When people-person 21 (on person.google))
(When people-person 21 (on person.password))
(Part people-person 22 note ((text "Signs in with Google")))
(When people-person 22 (on person.google))
(When people-person 22 (off person.password))
(Part people-person 23 note ((text "Signs in with a hive password")))
(When people-person 23 (off person.google))
(When people-person 23 (on person.password))

; their role, changed here for anyone else still in the hive
(Part people-person 30 chooser ((label (bind person.role_label)) (value person.role) (action set-role)
  (options ((option member "Member") (option admin "Admin")))))
(When people-person 30 (on can.update))
(When people-person 30 (none-of ((on person.disabled) (on person.self))))

; what can be done to someone else, side by side in one row (never to yourself)
; removing and restoring
(Part people-person 40 actions ((items ((action "Remove" toggle-access)))))
(Row people-person 40 person-actions)
(When people-person 40 (on can.update))
(When people-person 40 (none-of ((on person.disabled) (on person.self))))
(Part people-person 41 actions ((items ((action "Restore" toggle-access)))))
(Row people-person 41 person-actions)
(When people-person 41 (on can.update))
(When people-person 41 (on person.disabled))
(When people-person 41 (off person.self))

; clearing a Google sign-in (admins)
(Part people-person 42 actions ((items ((action "Clear Google sign-in" clear-google)))))
(Row people-person 42 person-actions)
(When people-person 42 (on viewer.admin))
(When people-person 42 (on can.clear_google))
(When people-person 42 (on person.google))
(When people-person 42 (off person.self))

; member passwords (admins, when this hive offers them, for someone still in the hive): make or reset one for a
; member, remove one anyone has
(Part people-person 43 actions ((items ((action "Reset password" reset-password)))))
(Row people-person 43 person-actions)
(When people-person 43 (on passwords.on))
(When people-person 43 (on viewer.admin))
(When people-person 43 (on can.reset_password))
(When people-person 43 (is person.role member))
(When people-person 43 (on person.password))
(When people-person 43 (none-of ((on person.disabled) (on person.self))))
(Part people-person 44 actions ((items ((action "Make a password" reset-password)))))
(Row people-person 44 person-actions)
(When people-person 44 (on passwords.on))
(When people-person 44 (on viewer.admin))
(When people-person 44 (on can.reset_password))
(When people-person 44 (is person.role member))
(When people-person 44 (off person.password))
(When people-person 44 (none-of ((on person.disabled) (on person.self))))
(Part people-person 45 actions ((items ((action "Remove password" remove-password)))))
(Row people-person 45 person-actions)
(When people-person 45 (on passwords.on))
(When people-person 45 (on viewer.admin))
(When people-person 45 (on can.reset_password))
(When people-person 45 (on can.remove_password))
(When people-person 45 (on person.password))
(When people-person 45 (none-of ((on person.disabled) (on person.self))))
