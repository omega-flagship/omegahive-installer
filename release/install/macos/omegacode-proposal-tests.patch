diff --git a/omegacode/proposal_tests/sandbox_api.py b/omegacode/proposal_tests/sandbox_api.py
new file mode 100644
index 0000000..4477470
--- /dev/null
+++ b/omegacode/proposal_tests/sandbox_api.py
@@ -0,0 +1,185 @@
+"""Purpose: execute retained proposal snapshots through the hive's original sandbox and result ledger."""
+import base64
+import json
+from typing import Annotated, Literal
+
+import httpx
+from fastapi import APIRouter, Depends, Header, Query
+from pydantic import BaseModel, ConfigDict, Field, StrictStr
+
+from omegacode.common import CodeError, canonical, digest
+from .launch_admission import candidate, scope_binding
+from .preparation_bind import BIND
+from .proposal_host_wire import fail, key
+
+KIND = 'proposal_sandbox_dispatch'
+MAX_SNAPSHOT = 20 * 1024 * 1024
+MAX_RESPONSE = 512 * 1024
+
+
+class LaunchBody(BaseModel):
+    model_config = ConfigDict(extra='forbid', strict=True)
+    launch_key: Annotated[StrictStr, Field(pattern='^[A-Za-z0-9_.:-]{8,120}$')]
+    runtime: Literal['python']
+    argv: Annotated[list[Annotated[StrictStr, Field(min_length=1, max_length=4096)]], Field(min_length=1, max_length=32)]
+    runtime_seconds: Annotated[int, Field(ge=6, le=120)]
+
+
+def host_call(host, method, path, body=None):
+    """The host's launch deadline owns execution; a lost reply never causes another dispatch."""
+    try:
+        with host._http.stream(method, host._url + path, json=body,
+                               headers={'Authorization': 'Bearer ' + host._token}, timeout=None) as response:
+            raw = bytearray()
+            for chunk in response.iter_bytes():
+                raw.extend(chunk)
+                if len(raw) > MAX_RESPONSE:
+                    fail('proposal_host_oversize')
+            value = json.loads(raw)
+            if response.status_code not in (200, 202):
+                error = value.get('error', {}) if isinstance(value, dict) else {}
+                code = error.get('code') if isinstance(error, dict) else error
+                raise CodeError(response.status_code, code or 'proposal_host_refused', 'host sandbox refused the original request')
+            if not isinstance(value, dict):
+                fail('proposal_host_shape')
+            return value
+    except (httpx.HTTPError, ValueError, UnicodeError):
+        fail('proposal_host_unavailable')
+
+
+def prepared(service, claims):
+    p = claims['proposal_test']
+    row = service.store.get('proposal_preparation', p['test_id'])
+    bound = service.store.get(BIND, p['test_id'])
+    fork = service.workspace(row['fork_workspace_id'])
+    expected = dict(workspace_id=fork['id'], preparation_digest='sha256:' + row['preparation_digest'])
+    if row['binding'] != scope_binding(claims) or bound['state'] != 'acknowledged' \
+            or bound['fingerprint'] != digest(canonical(bound['body'])) \
+            or p['fork'] != expected or fork.get('proposal_test_id') != p['test_id'] \
+            or fork['generation'] != 2 or fork['tree_digest'] != row['test_tree_digest']:
+        fail('proposal_sandbox_binding')
+    return row, fork
+
+
+def snapshot(service, authority, principal, command):
+    candidate(service, authority, principal)
+    claims = principal.grant
+    row, fork = prepared(service, claims)
+    p = claims['proposal_test']
+    binding = {name: p[name] for name in ('test_id', 'request_id', 'lease_id', 'controller_id', 'issuer', 'proposal', 'parent', 'fork')}
+    binding.update(schema='omegacode-project-test-binding/1', service_id=claims['aud'], capability_id=claims['id'],
+                   repository_id=claims['repository_id'], test_tree_digest='sha256:' + row['test_tree_digest'], **command)
+    manifest = service.manifest(fork)
+    if len(manifest['files']) > 2000 or digest(canonical(manifest)) != row['test_tree_digest']:
+        fail('proposal_sandbox_snapshot')
+    files, size = {}, 0
+    # Time: n files + b source bytes encoded. Space: b encoded source bytes.
+    for path, meta in manifest['files'].items():
+        data = service.store.read_blob(meta['digest'], fork['id'])
+        size += len(data)
+        if len(data) != meta['size'] or digest(data) != meta['digest'] \
+                or len(data) > 2 * 1024 * 1024 or size > 15 * 1024 * 1024:
+            fail('proposal_sandbox_snapshot')
+        files[path] = base64.b64encode(data).decode('ascii')
+    raw = canonical(dict(schema='hive-code-project-snapshot/1', binding=binding, manifest=manifest,
+                         tree_digest=row['test_tree_digest'], argv=command['argv'],
+                         interpreter=command['argv'][0], files=files))
+    if len(raw) > MAX_SNAPSHOT:
+        fail('proposal_sandbox_snapshot')
+    return binding, raw
+
+
+def currency(service, claims, binding):
+    parent = service.workspace(binding['parent']['workspace_id'])
+    row, fork = prepared(service, claims)
+    return 'current' if parent['generation'] == binding['parent']['generation'] \
+        and 'sha256:' + parent['tree_digest'] == binding['parent']['tree_digest'] \
+        and 'sha256:' + row['test_tree_digest'] == binding['test_tree_digest'] else 'stale'
+
+
+def projection(service, claims, saved, value, *, historical=False):
+    record = value.get('result') if historical else value
+    binding = saved['binding']
+    if not isinstance(record, dict) or record.get('test_id') != binding['test_id'] \
+            or record.get('launch_key') != saved['launch_key']:
+        fail('proposal_sandbox_result')
+    receipt = record.get('receipt')
+    unresolved = record.get('schema') == 'omegacode-sandbox-dispatch/1'
+    if unresolved:
+        if record.get('binding') != binding or record.get('state') != 'dispatch_unresolved':
+            fail('proposal_sandbox_result')
+    elif record.get('schema') != 'omegacode-sandbox-dispatch-result/1' or not isinstance(receipt, dict) \
+            or receipt.get('binding') != binding or receipt.get('snapshot_digest') != saved['body']['snapshot_digest'] \
+            or receipt.get('digest') != 'sha256:' + digest(canonical({k: v for k, v in receipt.items() if k != 'digest'})):
+        fail('proposal_sandbox_result')
+    source = 'unknown' if historical else currency(service, claims, binding)
+    execution = value.get('execution_currency', 'unknown') if historical else 'current'
+    if execution not in ('current', 'stale', 'unknown'):
+        fail('proposal_sandbox_result')
+    return dict(record=record, currency=source, execution_currency=execution,
+                tested=not historical and not unresolved and source == execution == 'current'
+                and receipt.get('command_outcome') == 'succeeded', accepted_source=False)
+
+
+def install(app, service, authority, host):
+    def principal(authorization: Annotated[str | None, Header()] = None,
+                  x_hive_token: Annotated[str | None, Header()] = None):
+        if not authorization or not authorization.startswith('Bearer '):
+            raise CodeError(401, 'authentication_required', 'a scoped bearer capability is required')
+        return authority.authenticate(authorization[7:], x_hive_token)
+
+    router = APIRouter()
+
+    @router.post('/v1/proposal-tests/{test_id}/launches', status_code=201)
+    def start(test_id: str, body: LaunchBody, p=Depends(principal)):
+        authority.require_route(p, 'POST', f'/v1/proposal-tests/{test_id}/launches')
+        command = body.model_dump(exclude={'launch_key'})
+        id_ = 'ps_' + digest(canonical([test_id, body.launch_key]))
+        with service.store.transaction():
+            service._check_owner(required=True)
+            saved = next((r for r in service.store.list(KIND) if r['id'] == id_), None)
+            if saved is None:
+                if sum(r['test_id'] == test_id for r in service.store.list(KIND)) >= 4:
+                    fail('proposal_sandbox_limit')
+                limits = p.grant['proposal_test']['allowance']
+                if not any(body.argv[:len(prefix)] == prefix for prefix in p.grant['argv_prefixes']):
+                    fail('proposal_launch_argv')
+                if body.runtime_seconds > min(limits['per_launch_max_runtime_seconds'],
+                                               limits['test']['runtime_seconds_remaining'],
+                                               limits['request']['runtime_seconds_remaining']) \
+                        or min(limits['test']['runs_remaining'], limits['request']['runs_remaining']) < 1:
+                    fail('proposal_launch_allowance')
+                binding, raw = snapshot(service, authority, p, command)
+                request = dict(capability_id=p.grant['id'], launch_key=body.launch_key, **command,
+                               snapshot_digest='sha256:' + digest(raw), snapshot_b64=base64.b64encode(raw).decode('ascii'))
+                saved = dict(id=id_, test_id=test_id, launch_key=body.launch_key, binding=binding,
+                             body=request, fingerprint=digest(canonical(request)))
+                service.store.put(KIND, saved)
+            elif any(saved['binding'][k] != v for k, v in command.items()):
+                fail('operation_conflict')
+            if saved['fingerprint'] != digest(canonical(saved['body'])):
+                fail('proposal_sandbox_binding')
+            prepared(service, p.grant)
+        # The host's durable original-key/body latch decides recovery, never a new capability or reconstructed snapshot.
+        value = host_call(host, 'POST', f'/api/services/proposal-tests/{test_id}/sandbox-runs', saved['body'])
+        authority.require_route(p, 'GET', f'/v1/proposal-tests/{test_id}')
+        return projection(service, p.grant, saved, value)
+
+    @router.get('/v1/proposal-tests/{test_id}')
+    def result(test_id: str, launch_key: Annotated[str | None, Query()] = None, p=Depends(principal)):
