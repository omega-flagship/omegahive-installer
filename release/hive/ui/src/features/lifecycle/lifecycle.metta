; The Lifecycle and leases page (#/swarms/<id>/lifecycle) and one skill on it, declared as atoms
; (screens/lib_screens.metta composes them). A person sets up, in three steps, which members a coordinating mind may
; run (a standing delegation), the exact skills it needs for that, and one run (a lease). Nothing takes effect until a
; confirmed Apply. The page composes each skill for its own facts, and the lifecycle screen stacks them.
;
; Facts the page states each time:
;   lifecycle: swarm.known swarm.has-coordinator minds.few coordinator.chosen member.chosen lease.issued;
;              the value lease.step (needs-coordinator, needs-delegation, needs-member, needs-task or ready);
;              (count deleg.current) (count rules.missing) (count tasks.open)
;   lifecycle-skill: coordinator.chosen skill.allowed

(Screen lifecycle "Lifecycle")

(Part lifecycle 1 empty ((icon alert) (title "No such swarm")))
(When lifecycle 1 (off swarm.known))

; ---------- what this page is
(Part lifecycle 10 header ((title "Lifecycle")
  (body "This is a setup page, not a list of waiting approvals. Nothing here is pending until you prepare it, and nothing takes effect until you apply it. Work through the three steps in order.")))
(When lifecycle 10 (on swarm.known))
(Part lifecycle 11 note ((text "A delegation (step 1) is standing: it says which members a coordinating mind may run, and lasts until you change it. A lease (step 3) is one run: one member, one task assigned to it, a time limit and a budget, usable once. The hive stops the member when its task ends, the lease expires, the budget runs out or its sandbox is missing.")))
(When lifecycle 11 (on swarm.known))
(Part lifecycle 12 note ((text "Only an admin signed in as a person can apply anything here.")))
(When lifecycle 12 (on swarm.known))

; ---------- step 1: who may run whom (a standing delegation)
(Part lifecycle 20 section ((title "1. Who may run whom")))
(When lifecycle 20 (on swarm.known))
(Part lifecycle 21 fields ((items ((field select "Coordinator" deleg.coordinator ((source deleg.minds) (prompt "Choose a mind")))))))
(When lifecycle 21 (on swarm.known))
(Part lifecycle 22 note ((text "This swarm needs at least two native minds (a coordinator and a member) before anything can be delegated.")))
(When lifecycle 22 (on swarm.known))
(When lifecycle 22 (off coordinator.chosen))
(When lifecycle 22 (on minds.few))
(Part lifecycle 23 note ((text "This swarm has no coordinator set. Choose the mind that should run the others.")))
(When lifecycle 23 (on swarm.known))
(When lifecycle 23 (off coordinator.chosen))
(When lifecycle 23 (off minds.few))
(When lifecycle 23 (off swarm.has-coordinator))
(Part lifecycle 24 fields ((items ((field checks "Members it may run (native minds of this swarm)" deleg.members ((action pick-member)))))))
(When lifecycle 24 (on swarm.known))
(When lifecycle 24 (on coordinator.chosen))
; applying it (held while nothing changed, or this hive cannot delegate), beside who it may run now
(Part lifecycle 25 actions ((tone primary) (items ((action "Apply delegation" apply-delegation deleg.held)))))
(Row lifecycle 25 delegation)
(When lifecycle 25 (on swarm.known))
(When lifecycle 25 (on coordinator.chosen))
(Part lifecycle 26 note ((text (words "Now: " (bind deleg.now)))))
(Row lifecycle 26 delegation)
(When lifecycle 26 (on swarm.known))
(When lifecycle 26 (on coordinator.chosen))

; ---------- step 2: the exact skills the coordinator needs, each allowed or not yet
(Part lifecycle 30 section ((title "2. Skills the coordinator needs")))
(When lifecycle 30 (on swarm.known))
(Part lifecycle 31 note ((text "Needs step 1: choose a coordinator first.")))
(When lifecycle 31 (on swarm.known))
(When lifecycle 31 (off coordinator.chosen))
(Part lifecycle 32 stack ((source skills.all) (label "Skills the coordinator needs")))
(When lifecycle 32 (on swarm.known))
; allowing what is missing; the button stays, held, when there is nothing to allow or no coordinator yet
(Part lifecycle 33 actions ((tone primary) (items ((action (bind rules.allow) allow-rules rules.held)))))
(When lifecycle 33 (on swarm.known))
(When lifecycle 33 (on coordinator.chosen))
(When lifecycle 33 (has rules.missing))
(Part lifecycle 34 actions ((tone primary) (items ((action "All allowed" allow-rules rules.held)))))
(When lifecycle 34 (on swarm.known))
(When lifecycle 34 (on coordinator.chosen))
(When lifecycle 34 (none rules.missing))
(Part lifecycle 35 actions ((tone primary) (items ((action "Choose a coordinator first" allow-rules rules.held)))))
(When lifecycle 35 (on swarm.known))
(When lifecycle 35 (off coordinator.chosen))

; ---------- step 3: one run (a lease), open once a coordinator may run at least one member
(Part lifecycle 40 section ((title "3. One run (a lease)")))
(When lifecycle 40 (on swarm.known))
(Part lifecycle 41 note ((text (words (bind hint.needs-coordinator) " Then you pick a member, a task assigned to it, a time limit and a budget. Nothing starts until the coordinator uses the lease."))))
(When lifecycle 41 (on swarm.known))
(When lifecycle 41 (is lease.step needs-coordinator))
(Part lifecycle 42 note ((text (words (bind hint.needs-delegation) " Then you pick a member, a task assigned to it, a time limit and a budget. Nothing starts until the coordinator uses the lease."))))
(When lifecycle 42 (on swarm.known))
(When lifecycle 42 (is lease.step needs-delegation))
(Part lifecycle 43 fields ((columns two) (items (
  (field select "Member" lease.member ((source lease.members) (prompt "Choose")))
  (field select "Task assigned to it" lease.task ((source lease.tasks) (prompt (bind lease.task_prompt)) (waits lease.task_held)))
  (field number (words "Duration (seconds, at most " (bind lease.max) ")") lease.seconds ((least 10) (most (bind lease.max))))
  (field number "Budget for this run (USD)" lease.budget ((least 0.01) (step 0.01)))))))
(When lifecycle 43 (on swarm.known))
(When lifecycle 43 (none-of ((is lease.step needs-coordinator) (is lease.step needs-delegation))))
; the member has no open task: a lease always runs one, so one can be created here
(Part lifecycle 44 note ((text (words (bind lease.member_name) " has no open task assigned to it. A lease always runs one assigned task. Create one here:"))))
(When lifecycle 44 (on swarm.known))
(When lifecycle 44 (none-of ((is lease.step needs-coordinator) (is lease.step needs-delegation))))
(When lifecycle 44 (on member.chosen))
(When lifecycle 44 (none tasks.open))
(Part lifecycle 45 fields ((items ((field text "New task title" task.new ((placeholder (words "What " (bind lease.member_name) " should do")) (quiet yes)))))))
(When lifecycle 45 (on swarm.known))
(When lifecycle 45 (none-of ((is lease.step needs-coordinator) (is lease.step needs-delegation))))
(When lifecycle 45 (on member.chosen))
(When lifecycle 45 (none tasks.open))
(Part lifecycle 46 actions ((items ((action "Create task" create-task task.held)))))
(When lifecycle 46 (on swarm.known))
(When lifecycle 46 (none-of ((is lease.step needs-coordinator) (is lease.step needs-delegation))))
(When lifecycle 46 (on member.chosen))
(When lifecycle 46 (none tasks.open))
; what the run still needs (a member chosen with no open task has the create box above instead)
(Part lifecycle 47 note ((text (bind hint.needs-member))))
(When lifecycle 47 (on swarm.known))
(When lifecycle 47 (is lease.step needs-member))
(Part lifecycle 48 note ((text (bind hint.needs-task))))
(When lifecycle 48 (on swarm.known))
(When lifecycle 48 (is lease.step needs-task))
(When lifecycle 48 (has tasks.open))
(Part lifecycle 49 actions ((tone primary) (items ((action "Issue lease" issue-lease lease.held)))))
(When lifecycle 49 (on swarm.known))
(When lifecycle 49 (none-of ((is lease.step needs-coordinator) (is lease.step needs-delegation))))
(Part lifecycle 50 note ((text (words "Sent to " (bind lease.coordinator_name) ". It can be used once, and only by " (bind lease.coordinator_name) "."))))
(When lifecycle 50 (on swarm.known))
(When lifecycle 50 (none-of ((is lease.step needs-coordinator) (is lease.step needs-delegation))))
(When lifecycle 50 (on lease.issued))

(Screen lifecycle-skill "A skill")
(Part lifecycle-skill 10 line ((title (bind skill.name)) (badge "allowed") (tone good)))
(When lifecycle-skill 10 (on coordinator.chosen))
(When lifecycle-skill 10 (on skill.allowed))
(Part lifecycle-skill 11 line ((title (bind skill.name)) (badge "not allowed yet") (tone warn)))
(When lifecycle-skill 11 (on coordinator.chosen))
(When lifecycle-skill 11 (off skill.allowed))
; before a coordinator is chosen nothing looks pending: the skill's name only
(Part lifecycle-skill 12 line ((title (bind skill.name))))
(When lifecycle-skill 12 (off coordinator.chosen))
