diff --git a/b/src/omegacode/symbolic_trace_reader.py b/src/omegacode/symbolic_trace_reader.py
new file mode 100644
index 0000000..8d9a571
--- /dev/null
+++ b/src/omegacode/symbolic_trace_reader.py
@@ -0,0 +1,489 @@
+"""Pure, bounded inspection of a retained cooperative symbolic transcript.
+
+Callers must obtain these bytes/records through the existing workspace custody
+and read/events authorization. Matching hashes here does not grant access or
+authenticate stdout: a program can print protocol-shaped JSON. This module does
+not import a runtime, execute, restore, replay, or claim current admission.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import math
+import re
+
+
+MAX_LOG = 4 * 1024 * 1024
+MAX_CONTROLS = 1024
+MAX_INPUT = 65536
+MAX_FRAMES = 4096
+MAX_TRACES = 32
+PROTOCOL = 'omegacode-symbolic-jsonl-v1'
+STEP_PROTOCOL = 'omegacode-hyperon-runner-step-v1'
+COVERAGE_MEANING = ('recent successful materialized step-next inspection batches; '
+                    'not advances, reductions or delivered output')
+STEP_OPS = ('step-start', 'step-next', 'step-status', 'step-clear')
+OBS_KEYS = {'input_sequence', 'step_count', 'status', 'results_digest', 'rendered_atoms_digest'}
+
+
+class TraceReadError(ValueError):
+    """The supplied evidence cannot support this reader's bounded schema."""
+
+    def __init__(self, code, message):
+        self.code = code
+        super().__init__(message)
+
+
+def _fail(code, message):
+    raise TraceReadError(code, message)
+
+
+def _bytes_digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _encoded(value):
+    try:
+        return json.dumps(value, sort_keys=True, separators=(',', ':'),
+                          ensure_ascii=False, allow_nan=False).encode('utf-8')
+    except (ValueError, TypeError, UnicodeError, RecursionError):
+        _fail('invalid_json_value', 'evidence contains a non-JSON value')
+
+
+def _digest(value):
+    return _bytes_digest(_encoded(value))
+
+
+def _unique(pairs):
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            _fail('duplicate_json_key', 'duplicate JSON object keys are refused')
+        value[key] = item
+    return value
+
+
+def _float(text):
+    value = float(text)
+    if not math.isfinite(value):
+        _fail('invalid_json_number', 'nonfinite JSON numbers are refused')
+    return value
+
+
+def _constant(_):
+    _fail('invalid_json_number', 'nonfinite JSON constants are refused')
+
+
+def _json(raw, limit):
+    if type(raw) is not bytes or not 0 < len(raw) <= limit:
+        _fail('json_size', 'JSON bytes are absent or exceed the reader bound')
+    try:
+        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique,
+                          parse_float=_float, parse_constant=_constant)
+    except TraceReadError:
+        raise
+    except (ValueError, UnicodeError, RecursionError):
+        _fail('invalid_json', 'evidence is not bounded valid UTF-8 JSON')
+
+
+def _int(value, low=0, high=MAX_FRAMES):
+    return type(value) is int and low <= value <= high
+
+
+def _text(value, limit=160):
+    if type(value) is not str or not 0 < len(value) <= limit:
+        return False
+    try:
+        return len(value.encode('utf-8')) <= limit
+    except UnicodeError:
+        return False
+
+
+def _hex(value):
+    return type(value) is str and re.fullmatch('[a-f0-9]{64}', value) is not None
+
+
+def _keys(value, required, optional=()):
+    if type(value) is not dict or not set(required) <= value.keys() or set(value) - set(required) - set(optional):
+        _fail('frame_schema', 'transcript object has missing or unknown fields')
+
+
+def _context(run):
+    if type(run) is not dict or any(not _text(run.get(k), 256) for k in ('id', 'workspace_id', 'nonce')):
+        _fail('run_binding', 'run identity is missing or malformed')
+    if (not _int(run.get('generation'), 1, 2**63-1) or not _hex(run.get('tree_digest'))
+            or run.get('terminal') is not True or not _hex(run.get('evaluator_digest'))):
+        _fail('run_binding', 'run is not a saved symbolic terminal generation')
+    if run.get('status') in ('prepared', 'starting', 'running', 'cancel_requested'):
+        _fail('run_not_final', 'historical inspection requires a terminal run record')
+    if not _text(run.get('status'), 64) or type(run.get('descendants_terminated')) is not bool:
+        _fail('run_binding', 'run termination metadata is malformed')
+    session = run.get('symbolic_session')
+    if (type(session) is not dict or session.get('protocol') != PROTOCOL
+            or not _text(session.get('runtime_id')) or not _hex(session.get('identity_digest'))
+            or not _hex(session.get('helper_digest'))
+            or session.get('all_inputs_require_run_authority') is not True
+            or session.get('sandboxed') is not False):
+        _fail('symbolic_binding', 'saved symbolic helper/runtime binding is malformed')
+    return {'run_id': run['id'], 'generation': run['generation'], 'tree_digest': run['tree_digest'],
+            'runtime_identity_digest': session['identity_digest'], 'runtime': 'hyperon'}
+
+
+def _inputs(controls, run):
+    """Reassemble submitted bytes; control sequence is NOT worker sequence."""
+    if type(controls) not in (list, tuple) or len(controls) > MAX_CONTROLS:
+        _fail('control_limit', 'at most 1024 ordered stored controls are supported')
+    stream, segments, ids = bytearray(), [], set()
+    for sequence, record in enumerate(controls, 1):
+        if (type(record) is not dict or not {'id', 'run_id', 'workspace_id', 'sequence', 'actor',
+                'payload', 'kind', 'input_bytes', 'input_digest'} <= record.keys()
+                or not _text(record.get('id')) or record['id'] in ids
+                or type(record.get('sequence')) is not int or record['sequence'] != sequence
+                or record.get('run_id') != run['id'] or record.get('workspace_id') != run['workspace_id']
+                or not _text(record.get('actor'), 256) or type(record.get('payload')) is not dict):
+            _fail('control_binding', 'stored controls need unique identity and contiguous run-bound sequence')
+        ids.add(record['id'])
+        payload = record['payload']
+        if payload.get('kind') != record.get('kind'):
+            _fail('control_binding', 'stored control kind differs from its payload')
+        if record['kind'] == 'resize':
+            if (type(record.get('input_bytes')) is not int or record['input_bytes'] != 0
+                    or record.get('input_digest') is not None
+                    or 'data_base64' in payload or any(not _int(payload.get(k), 1, 500) for k in ('rows', 'cols'))):
+                _fail('control_binding', 'resize control is malformed')
+            continue
+        if record['kind'] != 'input' or any(k in payload for k in ('rows', 'cols')):
+            _fail('control_binding', 'unknown or mixed stored terminal control')
+        try:
+            if type(payload.get('data_base64')) is not str or len(payload['data_base64']) > 10924:
+                raise ValueError()
+            data = base64.b64decode(payload['data_base64'], validate=True)
+        except (ValueError, TypeError):
+            _fail('control_binding', 'stored input is not valid base64')
+        if (not 1 <= len(data) <= 8192 or type(record.get('input_bytes')) is not int
+                or record['input_bytes'] != len(data) or record.get('input_digest') != _bytes_digest(data)):
+            _fail('control_binding', 'stored input length or digest differs from submitted bytes')
+        if len(stream) + len(data) > MAX_INPUT:
+            _fail('input_limit', 'submitted input stream exceeds 65536 bytes')
+        segments.append((len(stream), len(stream) + len(data), sequence))
+        stream.extend(data)
+    requests, offset = {}, 0
+    while b'\n' in stream[offset:]:
+        end = stream.index(b'\n', offset) + 1
+        raw = bytes(stream[offset:end])
+        if len(raw) > 8192 or len(requests) >= MAX_FRAMES:
+            _fail('input_alignment_unknown', 'input framing exceeds the supported worker bounds')
+        request = _json(raw, 8192)
+        if type(request) is not dict:
+            _fail('input_alignment_unknown', 'non-object input prevents supported command correlation')
+        touched = [sequence for start, stop, sequence in segments if start < end and stop > offset]
+        requests[len(requests)+1] = {'request': request, 'frame_digest': _bytes_digest(raw),
+            'controls': {'first': touched[0], 'last': touched[-1]}}
+        offset = end
+    if len(stream) - offset > 8192:
+        _fail('input_alignment_unknown', 'unterminated submitted input exceeds a worker frame')
+    return requests, offset != len(stream)
+
+
+def _trace_catalog(requests, context):
+    catalog = {}
+    for sequence, item in requests.items():
+        request = item['request']
+        source, budget = request.get('source'), request.get('max_steps', 10000)
+        if (request.get('op') != 'step-start' or not _text(request.get('id'))
+                or set(request) - {'id', 'op', 'source', 'max_steps'}
+                or not _text(source, 7000) or not _int(budget, 1, 10000)):
+            continue
+        source_digest = _bytes_digest(source.encode('utf-8'))
+        trace_id = 'step_' + _digest([context, source_digest, sequence])
+        catalog[trace_id] = {'start_sequence': sequence, 'source_digest': source_digest, 'max_steps': budget}
+    return catalog
+
+
+def _coverage(value, rows):
+    _keys(value, {'total_observations', 'retained_observations', 'dropped_observations', 'truncated',
+                 'first_retained_input_sequence', 'first_retained_step_count', 'window_limit', 'coverage'})
+    total, retained, dropped = (value.get(k) for k in ('total_observations', 'retained_observations', 'dropped_observations'))
+    if (not all(_int(n) for n in (total, retained, dropped)) or retained != len(rows)
+            or retained != min(total, 100)
+            or dropped != total-retained or type(value['truncated']) is not bool
+            or value['truncated'] != (dropped > 0) or type(value['window_limit']) is not int
+            or value['window_limit'] != 100 or value['coverage'] != COVERAGE_MEANING
+            or value['first_retained_input_sequence'] != (rows[0]['input_sequence'] if rows else None)
+            or value['first_retained_step_count'] != (rows[0]['step_count'] if rows else None)):
+        _fail('coverage_invalid', 'declared observation coverage is inconsistent')
+    # Equality alone would accept booleans in integer cursor fields.
+    if rows and (type(value['first_retained_input_sequence']) is not int
+                 or type(value['first_retained_step_count']) is not int):
+        _fail('coverage_invalid', 'coverage cursors must be actual integers')
+    return value.copy()
+
+
+def _trace_result(result, request, sequence, context, catalog, traces, observations, requests, reasons):
+    required = {'trace_id', 'source_digest', 'context', 'step_count', 'max_steps', 'status', 'results',
+        'observations', 'results_currency', 'last_observed_step', 'engine_api', 'substitutions_available',
+        'grounded_call_trace_available', 'persistence', 'effects_reversed'}
+    coverage_keys = {'observation_coverage', 'observation_total', 'observation_window_limit',
+        'observation_dropped_prefix', 'first_retained_input_sequence', 'first_retained_step'}
+    _keys(result, required, coverage_keys)
+    trace_id = result['trace_id']
+    saved = catalog.get(trace_id) if type(trace_id) is str else None
+    if (saved is None or result['source_digest'] != saved['source_digest'] or _encoded(result['context']) != _encoded(context)
+            or result['max_steps'] != saved['max_steps'] or type(result['max_steps']) is not int
+            or not _int(result['step_count'], 0, saved['max_steps'])
+            or saved['start_sequence'] > sequence
+            or (request['op'] == 'step-start' and saved['start_sequence'] != sequence)
+            or (request['op'] != 'step-start' and request.get('trace_id') != trace_id)):
+        _fail('trace_binding', 'reported trace differs from saved context or submitted source')
+    if (result['status'] not in ('paused', 'complete', 'budget-exhausted', 'faulted')
+            or result['engine_api'] != 'hyperon.runner.RunnerState.run_step'
+            or result['substitutions_available'] is not False or result['grounded_call_trace_available'] is not False
+            or result['effects_reversed'] is not False
+            or result['persistence'] != 'resident process only; no automatic replay'):
+        _fail('trace_schema', 'reported trace capability metadata is unsupported')
+    groups = result['results']
+    if (type(groups) is not list or any(type(group) is not list or any(type(atom) is not str for atom in group)
+                                      for group in groups) or len(_encoded(groups)) > 262144):
+        _fail('trace_schema', 'reported result groups are malformed or oversized')
+    rows = result['observations']
+    if type(rows) is not list or len(rows) > 100:
+        _fail('observation_schema', 'reported recent window exceeds 100 observations')
