+def test_enrolment_retry_reuses_operation_after_lost_register_response(tmp_path, repo):
+    root = tmp_path / "registration-retry"
+    operation_ids = []
+    def lost(request):
+        operation_ids.append(json.loads(request.content)["operation_id"])
+        raise httpx.ConnectError("synthetic lost response", request=request)
+    s = Service(root, OPERATOR, {"synthetic": {"path": str(repo)}}, "http://hive.invalid", httpx.MockTransport(lost))
+    try:
+        client = TestClient(create_app(s))
+        response = client.post("/v1/operator/register", headers={"Authorization": "Bearer " + OPERATOR},
+                               json={"enrol_token": "synthetic-one-time-enrol-token"})
+        assert response.status_code == 503 and response.json()["error"] == "registration_unknown"
+        operation = json.loads((root / "registration.operation.json").read_text())
+        operation_id = operation["operation_id"]
+        assert operation_ids == [operation_id]
+    finally:
+        s.close()
+
+    seen = []
+    def recovered(request):
+        seen.append(request)
+        if request.url.path.endswith("/register"):
+            body = json.loads(request.content)
+            assert body["operation_id"] == operation_id
+            return httpx.Response(201, json={"service_id": "svc-retry", "service_token": "synthetic-service-secret",
+                "capability_secret": "synthetic-capability-secret", "address": "http://127.0.0.1:8724",
+                "receipt": {"operation_id": operation_id, "request_digest": "b" * 64,
+                            "service_id": "svc-retry", "status": "pending"}})
+        return httpx.Response(200, json={"operation_id": operation_id, "request_digest": "b" * 64,
+                                         "service_id": "svc-retry", "status": "active"})
+    s2 = Service(root, OPERATOR, {"synthetic": {"path": str(repo)}}, "http://hive.invalid", httpx.MockTransport(recovered))
+    try:
+        response = TestClient(create_app(s2)).post("/v1/operator/register", headers={"Authorization": "Bearer " + OPERATOR},
+                                                    json={"enrol_token": "synthetic-one-time-enrol-token"})
+        assert response.status_code == 201
+        assert len([r for r in seen if r.url.path.endswith("/register")]) == 1
+        assert not (root / "registration.operation.json").exists()
+    finally:
+        s2.close()
+
+
+def test_enrolment_recovers_ack_that_committed_before_response_loss(tmp_path, repo):
+    operation_id = None
+    state = {"active": False}
+    def transport(request):
+        nonlocal operation_id
+        if request.url.path.endswith("/register"):
+            operation_id = json.loads(request.content)["operation_id"]
+            return httpx.Response(201, json={"service_id": "svc-ack", "service_token": "synthetic-ack-secret",
+                "capability_secret": "synthetic-capability-secret", "address": "http://127.0.0.1:8724",
+                "receipt": {"operation_id": operation_id, "request_digest": "c" * 64,
+                            "service_id": "svc-ack", "status": "pending"}})
+        if request.url.path.endswith("/ack"):
+            state["active"] = True
+            raise httpx.ReadTimeout("synthetic lost ack response", request=request)
+        return httpx.Response(200, json={"operation_id": operation_id, "request_digest": "c" * 64,
+                                         "service_id": "svc-ack", "status": "active" if state["active"] else "pending"})
+    s = Service(tmp_path / "registration-ack", OPERATOR, {"synthetic": {"path": str(repo)}},
+                "http://hive.invalid", httpx.MockTransport(transport))
+    try:
+        response = TestClient(create_app(s)).post("/v1/operator/register", headers={"Authorization": "Bearer " + OPERATOR},
+                                                   json={"enrol_token": "synthetic-one-time-enrol-token"})
+        assert response.status_code == 201
+        assert s.authority.registration["receipt"]["status"] == "active"
+        assert state["active"] and not (s.store.root / "registration.operation.json").exists()
+    finally:
+        s.close()
