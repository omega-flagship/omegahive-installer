!(test (may-start (Ctx pl1 e1 jon (dot planner) (Caps 2 2 2) 3 review-required (rf)) (replay (Ctx pl1 e1 jon (dot planner) (Caps 2 2 2) 3 review-required (rf)) (start-state) (par-red))) (page app docs))
; reviewer exclusion covers the repairer too
