+            _keys(result, {'trace_id', 'cleared', 'effects_reversed'})
+            if (not _text(result['trace_id']) or result['trace_id'] != request.get('trace_id')
+                    or result['trace_id'] not in traces
+                    or result['cleared'] is not True or result['effects_reversed'] is not False):
+                _fail('clear_binding', 'clear response lacks a previously observed trace binding')
