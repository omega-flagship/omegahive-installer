!(test (last-rc (append (cap-red) ((o 7 piece-started (app t1 coder-a (team code))) (o 8 piece-started (docs t2 coder-b (team code)))))) (rejected assignee-cap-full))
!(test (last-rc (append (cap-red) ((o 7 piece-started (app t1 coder-a (team code))) (o 8 piece-started (page t2 studio-a (team studio)))))) accepted)
!(test (last-rc ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (par-graph) () (Needs no-design author () ((AssigneeCap (Assignee team code) zero))))))) (rejected invalid_needs))
