+def test_concurrent_enrolments_cannot_create_two_service_identities(tmp_path, repo):
+    root = tmp_path / "registration-race"
+    guard = threading.Lock()
+    calls = {"register": 0, "ack": 0}
+    def transport(request):
+        if request.url.path.endswith("/register"):
+            body = json.loads(request.content)
+            with guard:
+                calls["register"] += 1
+            time.sleep(0.05)
+            return httpx.Response(201, json={"service_id": "svc-race", "service_token": "synthetic-race-token",
+                "capability_secret": "synthetic-race-key", "address": "http://127.0.0.1:8724",
+                "receipt": {"operation_id": body["operation_id"], "request_digest": "f" * 64,
+                            "service_id": "svc-race", "status": "pending"}})
+        if request.url.path.endswith("/ack"):
+            with guard:
+                calls["ack"] += 1
+            body = json.loads((root / "registration.json").read_text())
+            return httpx.Response(200, json={**body["receipt"], "status": "active"})
+        raise AssertionError(request.url)
+    s = Service(root, OPERATOR, {"synthetic": {"path": str(repo)}}, "http://hive.invalid", httpx.MockTransport(transport))
+    def attempt(token):
+        try:
+            return enrol(s.authority, root, token, 8724)
+        except CodeError as error:
+            return error.code
+    try:
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            results = list(pool.map(attempt, ["synthetic-enrol-token-first", "synthetic-enrol-token-second"]))
