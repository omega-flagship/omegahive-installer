; One app's page (#/program/<id>): the app in its own space, declared as atoms (screens/lib_screens.metta composes
; them). The app draws itself: its frame, its native form, its work graph, and Create's Code and Flow benches are
; islands the page offers and these atoms place. MeTTa composes everything around them: the notes over the app, the
; states before it opens, the bench tabs, and the app's Ω menu entries.
;
; The page states one set of facts for program, program-stage and program-menu (features/programs/appPage.ts):
;   flags  app.current (a swarm is open) app.ui (the app has its own interface) app.form (a form is built for it)
;          app.create (it is Create) app.person (a person app) view.graph view.own (the views asked for)
;          bench.code bench.flow bench.make (Create's benches) view.access (where it runs is open) can.access
;          homes.here (it is set up in the open swarm) homes.denied swarms.several person.key person.monthly
;   counts homes.all (where it is set up) swarms.choices (swarms the person may pick)
;   values homes (pending, known, absent or failed) pick (pending, chosen or nowhere) form.kind
;          person (opening, ready or failed) person.helpers person.reason person.action
; program-closed (an app this person may not open here) states only the value state (opening, unlisted or
; unreadable) and can.retry.

; ---------- above the app: notes on where it opened, and Create's benches
(Screen program "An app")
; opened in a swarm where it is not set up: where it is, each a way there
(Part program 10 notice ((tone warn) (text (words (bind app.name) " is not set up in " (bind swarm.name) ". It works in:"))))
(Row program 10 homes)
(When program 10 (on app.current))
(When program 10 (has homes.all))
(When program 10 (off homes.here))
(Part program 11 list ((label "Where it works") (source homes.known) (title name) (open home)))
(Row program 11 homes)
(When program 11 (on app.current))
(When program 11 (has homes.all))
(When program 11 (off homes.here))
; a swarm whose coordinator is not awake says so, with the way to that mind (it draws nothing while it is awake)
(Part program 20 island ((name coordinator)))
(When program 20 (off app.person))
; a person app: its helpers need the person's own AI key, or were turned down; and who can see it
(Part program 30 notice ((tone warn) (text (words (bind app.name) "'s helpers run on your own AI key. Opening it costs nothing; they stay unavailable until then."))))
(Row program 30 person-key)
(When program 30 (on app.current))
(When program 30 (is person ready))
(When program 30 (on person.key))
(When program 30 (off person.monthly))
(Part program 31 notice ((tone warn) (text (words (bind app.name) "'s helpers run on your own AI key, within a monthly total you set. Opening it costs nothing; they stay unavailable until then."))))
(Row program 31 person-key)
(When program 31 (on app.current))
(When program 31 (is person ready))
(When program 31 (on person.key))
(When program 31 (on person.monthly))
(Part program 32 buttons ((items ((button "Add your AI key" settings ()) (button "I've added it" person-reopen ())))))
(Row program 32 person-key)
(When program 32 (on app.current))
(When program 32 (is person ready))
(When program 32 (on person.key))
(Part program 33 notice ((tone info) (text "Your helpers are off. Nothing was set up, so helper features are unavailable.")))
(Row program 33 person-declined)
(When program 33 (on app.current))
(When program 33 (is person ready))
(When program 33 (is person.helpers declined))
(Part program 34 buttons ((items ((button "Set up helpers" person-helpers ())))))
(Row program 34 person-declined)
(When program 34 (on app.current))
(When program 34 (is person ready))
(When program 34 (is person.helpers declined))
(Part program 35 note ((text "Private to you; hive admins can audit.")))
(When program 35 (on app.current))
(When program 35 (is person ready))
; the one Stop of a live drawing session, in the page's flow (it draws nothing without one)
(Part program 38 island ((name studio-live)))
; Create's benches side by side: Studio (the canvas), Make (one sentence to a finished thing), Code and Flow
(Part program 40 tabs ((tour create-benches) (label "Create benches") (bind bench) (source benches)))
(When program 40 (on app.create))
(When program 40 (on app.current))
; starting live drawing from what the Ask prepared
(Part program 50 island ((name drawing-entry)))
(When program 50 (on app.create))

; ---------- the app itself, and what shows until it opens
(Screen program-stage "The app")
; the app's own interface. It stays mounted, hidden, under the graph and the benches, so the app keeps its state.
(Part program-stage 10 island ((name app-frame) (hidden-when (view.graph bench.code bench.flow bench.make))))
(When program-stage 10 (on app.current))
(When program-stage 10 (on app.ui))
(When program-stage 10 (any ((off app.form) (on view.own))))
; the form built for it, in the person's experience (kept mounted under the benches, with its unsaved work)
(Part program-stage 20 island ((name app-form) (hidden-when (bench.code bench.flow bench.make))))
(When program-stage 20 (on app.current))
(When program-stage 20 (on app.form))
(When program-stage 20 (off view.graph))
(When program-stage 20 (any ((off app.ui) (off view.own))))
; its work as a graph: asked for, or the only view an app with neither an interface nor a form has
(Part program-stage 30 island ((name app-graph) (hidden-when (bench.code bench.flow bench.make))))
(When program-stage 30 (on app.current))
(When program-stage 30 (any ((on view.graph) (none-of ((on app.ui) (on app.form))))))
; Create's Code and Flow benches
(Part program-stage 40 island ((name code-bench)))
(When program-stage 40 (on bench.code))
(Part program-stage 50 island ((name flow-bench)))
(When program-stage 50 (on bench.flow))
; Create's Make bench: one sentence becomes a plan the teams build with the person watching (createPlan/plan.metta)
(Part program-stage 55 island ((name make-bench)))
(When program-stage 55 (on bench.make))

; a person app whose own space could not be opened: one approved reason and its one action
(Part program-stage 60 empty ((icon shield) (title (bind person.reason_text))))
(When program-stage 60 (off app.current))
(When program-stage 60 (on app.person))
(When program-stage 60 (is person failed))
(When program-stage 60 (is person.reason not_available_to_you))
(Part program-stage 61 empty ((icon alert) (title (bind person.reason_text))))
(When program-stage 61 (off app.current))
(When program-stage 61 (on app.person))
(When program-stage 61 (is person failed))
(When program-stage 61 (none-of ((is person.reason not_available_to_you))))
(Part program-stage 62 buttons ((items ((button (bind person.action_label) person-try ((variant primary)))))))
(When program-stage 62 (off app.current))
(When program-stage 62 (on app.person))
(When program-stage 62 (is person failed))
(When program-stage 62 (is person.action try_again))
(Part program-stage 63 buttons ((items ((button (bind person.action_label) person-setup ((variant primary)))))))
(When program-stage 63 (off app.current))
(When program-stage 63 (on app.person))
(When program-stage 63 (is person failed))
(When program-stage 63 (is person.action set_up_again))
(Part program-stage 64 buttons ((items ((button (bind person.action_label) leave ())))))
(When program-stage 64 (off app.current))
(When program-stage 64 (on app.person))
(When program-stage 64 (is person failed))
(When program-stage 64 (any ((is person.action back) (is person.action ask_admin))))
; a person app while the hive makes its space
(Part program-stage 65 note ((text (words "Opening " (bind app.name) "…"))))
(When program-stage 65 (off app.current))
(When program-stage 65 (on app.person))
(When program-stage 65 (none-of ((is person failed))))

; the hive did not say where the app is set up: nothing was opened
(Part program-stage 70 empty ((icon alert) (title (words "Couldn't check where " (bind app.name) " works"))
  (body (words "This hive did not let you see where " (bind app.name) " is set up. Nothing was opened. Try again, or pick a swarm from Ω → Works in."))))
(When program-stage 70 (off app.current))
(When program-stage 70 (off app.person))
(When program-stage 70 (is homes failed))
(When program-stage 70 (on homes.denied))
(Part program-stage 71 empty ((icon alert) (title (words "Couldn't check where " (bind app.name) " works"))
  (body (words "The hive did not answer where " (bind app.name) " is set up. Nothing was opened. Try again, or pick a swarm from Ω → Works in."))))
(When program-stage 71 (off app.current))
(When program-stage 71 (off app.person))
(When program-stage 71 (is homes failed))
(When program-stage 71 (off homes.denied))
(Part program-stage 72 buttons ((items ((button "Try again" retry-homes ((variant primary)))))))
(When program-stage 72 (off app.current))
(When program-stage 72 (off app.person))
(When program-stage 72 (is homes failed))

; not turned on in any swarm the person can use (an admin turns it on when they install it)
(Part program-stage 75 empty ((icon apps) (title (words (bind app.name) " isn't turned on in a swarm you can use"))
  (body "An admin turns this app on for swarms when they install it. Ask an admin, or pick a swarm from Ω → Works in.")))
(When program-stage 75 (off app.current))
(When program-stage 75 (off app.person))
(When program-stage 75 (is homes known))
(When program-stage 75 (none homes.all))
(Part program-stage 76 buttons ((items ((button "Back to Apps" leave ())))))
(When program-stage 76 (off app.current))
(When program-stage 76 (off app.person))
(When program-stage 76 (is homes known))
(When program-stage 76 (none homes.all))

; nowhere to open it by itself: the person picks a swarm, never a guess
(Part program-stage 80 empty ((icon swarms) (title (words "Choose where to open " (bind app.name)))
  (body (words "Couldn't tell where it's set up. " (bind app.name) " works inside a swarm; pick one."))))
(When program-stage 80 (off app.current))
(When program-stage 80 (off app.person))
(When program-stage 80 (is pick nowhere))
(When program-stage 80 (is homes absent))
(When program-stage 80 (has swarms.choices))
(Part program-stage 81 empty ((icon swarms) (title (words "Choose where to open " (bind app.name)))
  (body (words "Couldn't tell where it's set up. " (bind app.name) " works inside a swarm. Pick one from Ω → Works in."))))
(When program-stage 81 (off app.current))
(When program-stage 81 (off app.person))
(When program-stage 81 (is pick nowhere))
(When program-stage 81 (is homes absent))
(When program-stage 81 (none swarms.choices))
(Part program-stage 82 empty ((icon swarms) (title (words "Choose where to open " (bind app.name)))
  (body (words (bind app.name) " works inside a swarm. Pick one you can use."))))
(When program-stage 82 (off app.current))
(When program-stage 82 (off app.person))
(When program-stage 82 (is pick nowhere))
(When program-stage 82 (none-of ((is homes absent))))
(When program-stage 82 (any ((none-of ((is homes known))) (has homes.all))))
(When program-stage 82 (has swarms.choices))
(Part program-stage 83 empty ((icon swarms) (title (words "Choose where to open " (bind app.name)))
  (body (words "There is no swarm here that you can use for " (bind app.name) " yet. Ask its owner, or pick one from Ω → Works in."))))
(When program-stage 83 (off app.current))
(When program-stage 83 (off app.person))
(When program-stage 83 (is pick nowhere))
(When program-stage 83 (none-of ((is homes absent))))
(When program-stage 83 (any ((none-of ((is homes known))) (has homes.all))))
(When program-stage 83 (none swarms.choices))
(Part program-stage 84 list ((label "Swarms you can use") (source swarms.choices) (title name) (open choose)))
(When program-stage 84 (off app.current))
(When program-stage 84 (off app.person))
(When program-stage 84 (is pick nowhere))
(When program-stage 84 (any ((none-of ((is homes known))) (has homes.all))))
(When program-stage 84 (has swarms.choices))

; on its way to a swarm
(Part program-stage 90 note ((text (words "Opening " (bind app.name) "…"))))
(When program-stage 90 (off app.current))
(When program-stage 90 (off app.person))
(When program-stage 90 (none-of ((is homes failed) (is pick nowhere))))
(When program-stage 90 (any ((none-of ((is homes known))) (has homes.all))))

; over the app: the Ω menu, where it runs, the questions it asks, and what helpers may do (each draws its own dialog)
(Part program-stage 95 island ((name omega-menu)))
(Part program-stage 96 island ((name app-access)))
(When program-stage 96 (on view.access))
(Part program-stage 97 island ((name confirm)))
(Part program-stage 98 island ((name consent)))
(When program-stage 98 (off app.person))
(Part program-stage 99 island ((name consent)))
(When program-stage 99 (on app.person))
(When program-stage 99 (on app.current))
(When program-stage 99 (is person ready))
(When program-stage 99 (none-of ((is person.helpers key) (is person.helpers declined))))

; ---------- the app's own entries in Ω (the page hands them to the menu: features/programs/appPage.ts)
(Screen program-menu "The app's menu")
(Part program-menu 10 buttons ((items ((button (words "Leave " (bind app.name)) leave ())))))
(Part program-menu 11 buttons ((items ((button "Code" bench-code ((checked bench.code)))))))
(When program-menu 11 (on app.create))
(When program-menu 11 (on app.current))
(Part program-menu 12 buttons ((items ((button "Flow" bench-flow ((checked bench.flow)))))))
(When program-menu 12 (on app.create))
(When program-menu 12 (on app.current))
(Part program-menu 13 buttons ((items ((button "Make" bench-make ((checked bench.make)))))))
(When program-menu 13 (on app.create))
(When program-menu 13 (on app.current))
(Part program-menu 16 buttons ((items ((button "Draw live in Create…" draw-live ())))))
(When program-menu 16 (on app.create))
(Part program-menu 17 buttons ((items ((button "Where it runs…" access ())))))
(When program-menu 17 (on can.access))
; its views: the form built for it, its own interface, and the graph
(Part program-menu 20 buttons ((section "View") (items ((button "Case file" view-form ((checked menu.form)))))))
(When program-menu 20 (on app.current))
(When program-menu 20 (is form.kind case-file))
(Part program-menu 21 buttons ((section "View") (items ((button "Body map" view-form ((checked menu.form)))))))
(When program-menu 21 (on app.current))
(When program-menu 21 (is form.kind life-map))
(Part program-menu 22 buttons ((section "View") (items ((button "Canvas" view-form ((checked menu.form)))))))
(When program-menu 22 (on app.current))
(When program-menu 22 (is form.kind design-canvas))
(Part program-menu 23 buttons ((section "View") (items ((button "App" view-form ((checked menu.form)))))))
(When program-menu 23 (on app.current))
(When program-menu 23 (is form.kind commons))
(Part program-menu 24 buttons ((section "View") (items ((button "App" view-own ((checked menu.own)))))))
(When program-menu 24 (on app.current))
(When program-menu 24 (on app.ui))
(When program-menu 24 (off app.form))
(Part program-menu 25 buttons ((section "View") (items ((button "Create" view-own ((checked menu.own)))))))
(When program-menu 25 (on app.current))
(When program-menu 25 (on app.ui))
(When program-menu 25 (on app.form))
(When program-menu 25 (on app.create))
(Part program-menu 26 buttons ((section "View") (items ((button "Studio" view-own ((checked menu.own)))))))
(When program-menu 26 (on app.current))
(When program-menu 26 (on app.ui))
(When program-menu 26 (on app.form))
(When program-menu 26 (off app.create))
(Part program-menu 27 buttons ((section "View") (items ((button "Graph" view-graph ((checked menu.graph)))))))
(When program-menu 27 (on app.current))
(When program-menu 27 (any ((on app.ui) (on app.form))))
; the swarms it can work in (a person app works in the person's own space)
(Part program-menu 40 list ((section "Works in") (source swarms.menu) (title label) (current (bind app.swarm)) (open works-in)))
(When program-menu 40 (off app.person))
(When program-menu 40 (on swarms.several))

; ---------- an app this person may not open here, or not yet known to be one: it names nothing of the app
(Screen program-closed "An app")
(Part program-closed 5 island ((name studio-live)))
(Part program-closed 10 note ((text "Opening the app…")))
(When program-closed 10 (is state opening))
(Part program-closed 20 empty ((icon shield) (title "This app isn't available to you here")
  (body "This hive doesn't offer that app to you. Your Apps page shows every app you can open.")))
(When program-closed 20 (is state unlisted))
(Part program-closed 21 empty ((icon apps) (title "The apps list could not be read") (body "Try again, or go to your Apps page.")))
(When program-closed 21 (is state unreadable))
(Part program-closed 30 buttons ((items ((button "Try again" retry ((variant primary)))))))
(Row program-closed 30 closed-actions)
(When program-closed 30 (is state unreadable))
(When program-closed 30 (on can.retry))
(Part program-closed 31 buttons ((items ((button "Back to Apps" leave ())))))
(Row program-closed 31 closed-actions)
(When program-closed 31 (none-of ((is state opening))))
(Part program-closed 90 island ((name omega-menu)))
