; Your personal mind (#/me/mind): the mind named after you, what it remembers, its hands, its version and what it
; handed on, declared as atoms (screens/lib_screens.metta composes them). The page composes each card for its own
; facts (its hands, what it remembers and each conversation in it, its version, what it handed on), and the mind
; screen stacks them: the hands and the memory in the main column, the version and the handoffs beside them on a wide
; screen (after them on a phone).
;
; Facts the page states each time:
;   mind: the standard resource facts for reading your mind (screens/resourceFacts.ts: the value resource,
;         resource.empty when the hive has no mind for you); mind.here mind.renaming mind.rename_problem mind.versioned
;   mind-hands: hands.live hands.seen; (count hands.steps)
;   mind-remembers: memory.ready talk.recall talk.unkept; the values memory.switch (lit dark plain) and
;                   collect.say (collecting lost volatile failed quiet); (count memory.notes) (count talk.all)
;   mind-talk: talk.open talk.truncated; (count talk.uses)
;   mind-version: the standard resource facts for reading its versions (unsupported: the hive has no version choice
;                 yet); version.current version.better version.scored version.measured version.can_adopt
;                 version.can_rollback version.busy version.said
;   mind-handed: (count handed.all)

(Screen mind "Your personal mind")

; ---------- reading your mind (the shared fragment: orders 10, 12 and 13)
; an account that is not a named person (refused): said calmly, as is a hive without personal minds below
(Resource mind 10 ((waiting "Finding your mind")
  (part forbidden empty ((icon mind) (title "Your personal mind isn’t set up on this hive yet")
    (body "A personal mind belongs to a signed-in person with an account here. The Ask still answers through your swarms.")))
  (part failed notice ((tone bad) (text "Your personal mind could not be read just now.")))))
(Part mind 14 actions ((items ((action "Try again" retry)))))
(When mind 14 (is resource failed))
; no personal mind on this hive, or none for this account yet: said calmly, with nothing broken around it
(Part mind 11 empty ((icon mind) (title "Your personal mind isn’t set up on this hive yet")
  (body "When this hive has personal minds, yours will be here, named after you. Until then the Ask answers through your swarms, and what it learns about you is still kept in this browser.")))
(When mind 11 (any ((is resource unsupported) (on resource.empty))))
(Part mind 15 buttons ((items ((button "Back to You" back ((variant ghost)))))))
(When mind 15 (any ((is resource unsupported) (is resource forbidden) (on resource.empty))))

; ---------- who it is: its name (renamed in place), whether it is awake, what it holds, and its figure
(Part mind 20 header ((eyebrow "Your personal mind") (title (bind mind.name)) (body "Your mind · alone in its own swarm")))
(When mind 20 (on mind.here))
(Part mind 21 buttons ((items ((button "Rename" rename-open ((variant ghost)))))))
(When mind 21 (on mind.here))
(When mind 21 (off mind.renaming))
(Part mind 22 rename ((label "Your mind’s name") (value (bind mind.name)) (maxlength 80) (action rename) (cancel_action stop-rename)))
(When mind 22 (on mind.here))
(When mind 22 (on mind.renaming))
(Part mind 23 notice ((tone bad) (text (bind mind.rename_problem))))
(When mind 23 (on mind.here))
(When mind 23 (on mind.rename_problem))
(Part mind 24 facts ((label "Who it is") (rows ((row "Now" (bind mind.presence)) (row "Remembers" (bind mind.remembers))
  (row "Energy" (bind mind.energy)) (row "Version" (bind mind.version))))))
(When mind 24 (on mind.here))
(When mind 24 (on mind.versioned))
(Part mind 25 facts ((label "Who it is") (rows ((row "Now" (bind mind.presence)) (row "Remembers" (bind mind.remembers))
  (row "Energy" (bind mind.energy))))))
(When mind 25 (on mind.here))
(When mind 25 (off mind.versioned))
; the figure, drawn in the look being worn (glass, constellation or line portrait): the page's own drawing
(Part mind 26 island ((name figure)))
(When mind 26 (on mind.here))

; ---------- its cards
(Part mind 40 stack ((source hands.card) (frame card) (label "Its hands")))
(When mind 40 (on mind.here))
(Part mind 50 stack ((tour mind-remembers) (source remembers.card) (frame card) (label (words "What " (bind mind.name) " remembers"))))
(When mind 50 (on mind.here))
(Part mind 60 stack ((source version.card) (frame card) (label "Version") (region_label "Its version and what it handed on")))
(Region mind 60 aside)
(When mind 60 (on mind.here))
(Part mind 70 stack ((source handed.card) (frame card) (label "Handed to swarms")))
(Region mind 70 aside)
(When mind 70 (on mind.here))

(Screen mind-hands "Its hands")
(Part mind-hands 10 line ((title "Its hands") (badge "Acting on your screen") (tone good)))
(When mind-hands 10 (on hands.live))
(Part mind-hands 11 line ((title "Its hands")))
(When mind-hands 11 (off hands.live))
(Part mind-hands 20 paragraph ((text (words "What " (bind mind.name) " is doing on this screen right now."))))
(When mind-hands 20 (on hands.live))
(Part mind-hands 21 paragraph ((text (words "What " (bind mind.name) " did on your screen last."))))
(When mind-hands 21 (off hands.live))
(When mind-hands 21 (on hands.seen))
(Part mind-hands 22 paragraph ((text (words (bind mind.name) " is not acting on your screen. When the Ask acts for you, you will see each step here."))))
(When mind-hands 22 (off hands.seen))
(Part mind-hands 30 list ((source hands.steps) (title text) (icon mark) (label "Its steps")))
(When mind-hands 30 (has hands.steps))
; taking back control while it acts
(Part mind-hands 40 buttons ((items ((button "Take back control" take-over ((variant primary)))))))
(Row mind-hands 40 take)
(When mind-hands 40 (on hands.live))
(Part mind-hands 41 note ((text "or click anywhere")))
(Row mind-hands 41 take)
(When mind-hands 41 (on hands.live))

(Screen mind-remembers "What it remembers")
(Part mind-remembers 10 line ((title (words "What " (bind mind.name) " remembers")) (badge "Memory on") (tone good)))
(When mind-remembers 10 (is memory.switch lit))
(Part mind-remembers 11 line ((title (words "What " (bind mind.name) " remembers")) (badge "Memory off")))
(When mind-remembers 11 (is memory.switch dark))
(Part mind-remembers 12 line ((title (words "What " (bind mind.name) " remembers")) (badge "Memory")))
(When mind-remembers 12 (is memory.switch plain))
(Part mind-remembers 13 paragraph ((text (bind memory.status))))

; its notes, from this browser's memory: each viewed, edited or forgotten in its own row (the rows the You page's
; memory section uses too, so they are the page's own: an island)
(Part mind-remembers 20 notice ((tone info) (text "Reading this browser’s memory…")))
(When mind-remembers 20 (off memory.ready))
(Part mind-remembers 21 island ((name notes)))
(When mind-remembers 21 (on memory.ready))
(When mind-remembers 21 (has memory.notes))
(Part mind-remembers 22 note ((text "No notes yet.")))
(When mind-remembers 22 (on memory.ready))
(When mind-remembers 22 (none memory.notes))

; the swarm talk it collected, and the person's own choice whether it is used in answers (off until they turn it on)
(Part mind-remembers 30 section ((title "From your swarm talk")
  (body (words "Copies of your own conversations with your swarms, remembered without waking " (bind mind.name) ". Read only; forget one and it is never used again."))))
(Part mind-remembers 31 toggles ((tour mind-talk-recall) (source talk.choice) (label label) (checked on) (action talk-recall)))
(When mind-remembers 31 (on memory.ready))
(Part mind-remembers 32 note ((text (words "When you ask, the conversations that matter go with your words, so " (bind mind.name) " gets to know you."))))
(When mind-remembers 32 (on talk.recall))
(Part mind-remembers 33 note ((text "Kept in your browser, not used in answers yet.")))
(When mind-remembers 33 (off talk.recall))
(Part mind-remembers 34 note ((text "Forget everything clears what’s remembered; your “Use my swarm talk in answers” choice stays as you set it.")))
(Part mind-remembers 40 stack ((source talk.all) (label "From your swarm talk")))
(When mind-remembers 40 (has talk.all))
(Part mind-remembers 41 note ((text "Swarm talk is not kept on this hive yet.")))
(When mind-remembers 41 (none talk.all))
(When mind-remembers 41 (on talk.unkept))
(Part mind-remembers 42 note ((text "Nothing yet. When you talk with one of your swarms, a copy is kept here.")))
(When mind-remembers 42 (none talk.all))
(When mind-remembers 42 (off talk.unkept))

; collecting it from the hive
(Part mind-remembers 50 notice ((tone info) (text "Collecting from the hive…")))
(When mind-remembers 50 (is collect.say collecting))
(Part mind-remembers 51 notice ((tone info) (text "Some older conversations weren’t collected in time, and the hive no longer holds them.")))
(When mind-remembers 51 (is collect.say lost))
(Part mind-remembers 52 notice ((tone info) (text "Your browser isn’t keeping memory here, so your swarm talk stays on the hive for now.")))
(When mind-remembers 52 (is collect.say volatile))
(Part mind-remembers 53 notice ((tone info) (text "The hive could not be reached just now; it keeps your conversations until this browser collects them.")))
(When mind-remembers 53 (is collect.say failed))

; keeping it safe: download it to a file, restore from one or keep it in a folder (shared with the You page's memory
; section, and it holds the file chooser and the folder link: an island)
(Part mind-remembers 60 island ((name keep-safe)))

(Screen mind-talk "A conversation it remembers")
(Part mind-talk 10 line ((title (bind talk.words)) (meta (bind talk.ago))))
(Part mind-talk 20 paragraph ((text (bind talk.short))))
(When mind-talk 20 (off talk.open))
(Part mind-talk 21 paragraph ((text (bind talk.answer))))
(When mind-talk 21 (on talk.open))
(When mind-talk 21 (off talk.truncated))
(Part mind-talk 22 paragraph ((text (words (bind talk.answer) " (cut short by the hive)"))))
(When mind-talk 22 (on talk.open))
(When mind-talk 22 (on talk.truncated))
(Part mind-talk 30 note ((text (bind talk.used))))
(When mind-talk 30 (has talk.uses))
(Part mind-talk 31 note ((text "not used yet")))
(When mind-talk 31 (none talk.uses))
(Part mind-talk 40 buttons ((items ((button "View" toggle-talk ((aria "All of: {talk.label}") (expanded talk.open) (variant ghost)))
  (button "Forget" forget-talk ((aria "Forget: {talk.label}") (variant ghost)))))))
(When mind-talk 40 (off talk.open))
(Part mind-talk 41 buttons ((items ((button "Less" toggle-talk ((aria "Less of: {talk.label}") (expanded talk.open) (variant ghost)))
  (button "Forget" forget-talk ((aria "Forget: {talk.label}") (variant ghost)))))))
(When mind-talk 41 (on talk.open))

(Screen mind-version "Its version")
(Part mind-version 10 line ((title "Version")))
(When mind-version 10 (off version.better))
(When mind-version 10 (off version.current))
(Part mind-version 11 line ((title "Version") (badge (bind version.current))))
(When mind-version 11 (off version.better))
(When mind-version 11 (on version.current))
(Part mind-version 12 line ((title (words (bind version.best) " is waiting")) (badge (bind version.current))))
(When mind-version 12 (on version.better))
; reading its versions (the shared fragment, each piece in the card's own words: orders 30, 31 and 33)
(Resource mind-version 30 ((part waiting paragraph ((text "Reading its version…")))
  (part unsupported paragraph ((text "Version choice comes later.")))
  (part failed paragraph ((text "Its version could not be read just now.")))))
(Part mind-version 40 paragraph ((text (words (bind mind.name) " runs " (bind version.current) (bind version.adopted) ". A better one is waiting."))))
(When mind-version 40 (is resource ready))
(When mind-version 40 (on version.current))
(When mind-version 40 (on version.better))
(Part mind-version 41 paragraph ((text (words (bind mind.name) " runs " (bind version.current) (bind version.adopted) ". It is the best measured so far."))))
(When mind-version 41 (is resource ready))
(When mind-version 41 (on version.current))
(When mind-version 41 (off version.better))
(Part mind-version 42 paragraph ((text (words (bind mind.name) "’s version is not known yet."))))
(When mind-version 42 (is resource ready))
(When mind-version 42 (off version.current))
; how the waiting one measured against the one it runs now
(Part mind-version 50 facts ((label (words "Now · " (bind version.current) ", best · " (bind version.best)))
  (rows ((row "Success" (bind version.success)) (row "Steps per task" (bind version.steps)) (row "Cost per task" (bind version.cost))))))
(When mind-version 50 (on version.scored))
(Part mind-version 51 note ((text (bind version.measured))))
(When mind-version 51 (on version.measured))
; adopting the better one, or going back to the one before (each asks first)
(Part mind-version 60 actions ((tone primary) (items ((action (words "Adopt " (bind version.best)) adopt version.busy)))))
(Row mind-version 60 version-acts)
(When mind-version 60 (on version.can_adopt))
(Part mind-version 61 actions ((items ((action "Roll back" rollback version.busy)))))
(Row mind-version 61 version-acts)
(When mind-version 61 (on version.can_rollback))
(Part mind-version 62 notice ((tone info) (text (bind version.say))))
(When mind-version 62 (on version.said))

(Screen mind-handed "Handed to swarms")
(Part mind-handed 10 line ((title "Handed to swarms")))
(Part mind-handed 20 paragraph ((text (words "Work " (bind mind.name) " passed to the right swarm’s coordinator, from this Ask thread. A full list across threads comes later."))))
(Part mind-handed 30 list ((source handed.all) (title text) (meta (at)) (label "Handed to swarms")))
(When mind-handed 30 (has handed.all))
(Part mind-handed 31 note ((text "Nothing handed on in this thread yet.")))
(When mind-handed 31 (none handed.all))
