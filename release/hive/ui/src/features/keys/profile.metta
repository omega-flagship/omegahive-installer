; The You page (#/me): who you are, your keys and which minds each key pays for, declared as atoms
; (screens/lib_screens.metta composes them). The page composes each provider's keys and each key for its own facts, and
; the profile screen stacks them.
;
; Facts the page states each time:
;   profile: the standard resource facts for your keys (screens/resourceFacts.ts: the value resource, resource.empty,
;            the data resource.error); client.connected signout.busy keys.adding me.person; (count keys.all)
;   profile-provider: (count group.keys)
;   profile-key: key.env key.default key.editing key.confirming key.account_usage key.account_limit
;                key.account_error; (count key.minds) (count key.assigned)

(Screen profile "You and your keys")

; ---------- who you are, and signing out
(Part profile 10 line ((title (bind me.name)) (orb me.hue) (orb-size 52)))
(Row profile 10 who)
(Part profile 11 actions ((items ((action "Sign out" sign-out signout.busy)))))
(Row profile 11 who)
(When profile 11 (on client.connected))
(When profile 11 (off signout.busy))
(Part profile 12 actions ((items ((action "Signing out…" sign-out signout.busy)))))
(Row profile 12 who)
(When profile 12 (on client.connected))
(When profile 12 (on signout.busy))
(Part profile 13 note ((text (bind me.line))))

; ---------- panels the page still draws itself (islands), in this order; each decides for itself whether it shows
(Part profile 20 island ((name personal-mind)))
(Part profile 21 island ((name google-connector)))
(Part profile 22 island ((name person-notices)))
(Part profile 23 island ((name look)))
(Part profile 24 island ((name clock)))
(Part profile 25 island ((name demo-ask)))
(Part profile 26 island ((name ask-memory)))

; ---------- your keys
(Part profile 30 section ((tour your-keys) (title "Your keys") (body (bind keys.summary))))
(When profile 30 (has keys.all))
(Part profile 31 section ((tour your-keys) (title "Your keys")))
(When profile 31 (none keys.all))
(Part profile 32 actions ((tone primary) (items ((action "Add a key" add-key - plus)))))
(When profile 32 (off keys.adding))
; adding a key: the page's own form (an island), so what is pasted never enters the page's data
(Part profile 33 island ((name add-key)))
(When profile 33 (on keys.adding))

; reading your keys (the shared fragment: orders 40 and 43)
(Resource profile 40 ((waiting "Loading your keys") (failed-title "Could not load your keys")))
; and a way to read them again (the page's own part: a failure after they were read keeps them on screen, unremarked)
(Part profile 44 actions ((items ((action "Try again" retry)))))
(When profile 44 (any ((is resource failed) (is resource forbidden))))

(Part profile 50 empty ((icon token) (title "No keys yet")
  (body "Add an OpenRouter key to give minds every major model, or a key straight from Anthropic or OpenAI.")))
(When profile 50 (is resource ready))
(When profile 50 (on resource.empty))
(Part profile 51 stack ((source keys.groups) (label "Your keys by provider")))
(When profile 51 (has keys.all))
(Part profile 60 note ((text "A key stays inside the hive, readable only by the hive process; only its last four characters are shown. Each provider has a default key that pays for any mind without one of its own. Pick a key for a mind in its Model tab, or when you create it.")))

; ---------- the monthly total on your own keys (a person's, not the operator's): the page's own panel
(Part profile 70 island ((name own-limit)))
(When profile 70 (on me.person))

(Screen profile-provider "A provider's keys")
(Part profile-provider 10 line ((title (bind group.label))))
(Part profile-provider 20 stack ((source group.keys) (frame card) (label (words (bind group.label) " keys"))))
(When profile-provider 20 (has group.keys))

(Screen profile-key "A key")
; its name (pressed to rename one stored in the hive), its last four characters, and whether it is the default
(Part profile-key 10 line ((title (bind key.label)) (open rename) (meta (bind key.hint)) (badge "Hive default") (tone good)))
(Row profile-key 10 key-head)
(When profile-key 10 (off key.editing))
(When profile-key 10 (off key.env))
(When profile-key 10 (on key.default))
(Part profile-key 11 line ((title (bind key.label)) (open rename) (meta (bind key.hint))))
(Row profile-key 11 key-head)
(When profile-key 11 (off key.editing))
(When profile-key 11 (off key.env))
(When profile-key 11 (off key.default))
(Part profile-key 12 line ((title (bind key.label)) (meta (words (bind key.hint) " · environment")) (badge "Hive default") (tone good)))
(Row profile-key 12 key-head)
(When profile-key 12 (on key.env))
(When profile-key 12 (on key.default))
(Part profile-key 13 line ((title (bind key.label)) (meta (words (bind key.hint) " · environment"))))
(Row profile-key 13 key-head)
(When profile-key 13 (on key.env))
(When profile-key 13 (off key.default))
(Part profile-key 14 rename ((label "Key name") (value (bind key.label)) (maxlength 60) (action rename) (cancel_action stop-rename)))
(Row profile-key 14 key-head)
(When profile-key 14 (on key.editing))
(When profile-key 14 (off key.env))
(Part profile-key 15 buttons ((items ((button "Check credits" refresh ((aria "Check the key and its credits") (icon reset) (variant ghost)))))))
(Row profile-key 15 key-head)

; what it has spent, here and on its account
(Part profile-key 20 note ((text (words (bind key.spent) " through this hive"))))
(Row profile-key 20 key-spend)
(Part profile-key 21 note ((text (words (bind key.account_usage) " used on the account of " (bind key.account_limit)))))
(Row profile-key 21 key-spend)
(When profile-key 21 (on key.account_usage))
(When profile-key 21 (on key.account_limit))
(Part profile-key 22 note ((text (words (bind key.account_usage) " used on the account, no limit"))))
(Row profile-key 22 key-spend)
(When profile-key 22 (on key.account_usage))
(When profile-key 22 (off key.account_limit))
(Part profile-key 23 notice ((tone warn) (text (bind key.account_error))))
(When profile-key 23 (on key.account_error))

; which minds it pays for (dashed in words: "as the default" when they have no key of their own)
(Part profile-key 30 note ((text "Pays for")))
(Row profile-key 30 key-pays)
(When profile-key 30 (has key.minds))
(Part profile-key 31 orbs ((source key.minds) (open mind) (aria "{name}, open model settings") (label "Minds this key pays for")))
(Row profile-key 31 key-pays)
(When profile-key 31 (has key.minds))
(Part profile-key 32 note ((text "Pays for no minds yet")))
(When profile-key 32 (none key.minds))

; making it the default, and removing it (a second press; never a key from the hive's environment)
(Part profile-key 40 actions ((items ((action "Make default" make-default)))))
(Row profile-key 40 key-actions)
(When profile-key 40 (off key.env))
(When profile-key 40 (off key.default))
(Part profile-key 41 actions ((items ((action "Remove" ask-remove)))))
(Row profile-key 41 key-actions)
(When profile-key 41 (off key.env))
(When profile-key 41 (off key.confirming))
(Part profile-key 42 confirm ((text "Remove this key?") (yes (words "Remove, move " (bind key.assigned_n) " to default"))
  (yes_action remove) (no "Keep") (no_action keep)))
(Row profile-key 42 key-actions)
(When profile-key 42 (off key.env))
(When profile-key 42 (on key.confirming))
(When profile-key 42 (has key.assigned))
(Part profile-key 43 confirm ((text "Remove this key?") (yes "Remove") (yes_action remove) (no "Keep") (no_action keep)))
(Row profile-key 43 key-actions)
(When profile-key 43 (off key.env))
(When profile-key 43 (on key.confirming))
(When profile-key 43 (none key.assigned))
