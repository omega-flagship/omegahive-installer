   (let* (($atom (py-call (hive_helpers.event_note_atom $spec)))
          ($parsed (sread $atom)))
        (if (== (car-atom $parsed) EventNoteError)
            (py-str (EVENT-NOTE-SHAPE-WARNING: $atom raw-command-preserved-in-history no-event-atom-written))
            (progn (add-atom &events $parsed)
                   (trace-atom "write" "events" $parsed "event-note")
                   (py-str (EVENT-NOTE-ADDED: $atom))))))

