; Research representation prototype, not shared-space installation or effect isolation.
(: EvolveRecord Type)
(: EvolveClaim (-> String String EvolveRecord))
(: evolve-body-digest (-> EvolveRecord String))
(= (evolve-body-digest (EvolveClaim $identifier $body)) $body)

(: EvolveStatusValue Type)
(: Current EvolveStatusValue)
(: Corrected EvolveStatusValue)
(: Retracted EvolveStatusValue)
(: EvolveRelation Type)
(: Correction EvolveRelation)
(: Retraction EvolveRelation)
(: Reference EvolveRelation)
(: EvolveCustodyValue Type)
(: Unresolved EvolveCustodyValue)
(: EvolveStatus (-> String EvolveStatusValue EvolveRecord))
(: EvolveSource (-> String String EvolveRecord))
(: EvolveCustody (-> String EvolveCustodyValue EvolveRecord))
(: EvolveNeedsReview (-> String EvolveRecord))
(: EvolveDepends (-> String String EvolveRecord))
(: EvolveLineage (-> String String EvolveRelation EvolveRecord))
(: evolve-status (-> String EvolveStatusValue))
(= (evolve-status $identifier) (match &self (EvolveStatus $identifier $status) $status))
(: evolve-needs-review? (-> String Bool))
(= (evolve-needs-review? $identifier) (match &self (EvolveNeedsReview $identifier) True))
