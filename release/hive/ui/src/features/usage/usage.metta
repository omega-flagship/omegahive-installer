; Purpose: the Usage page, declared as atoms (screens/lib_screens.metta composes it): the hive's spend alerts, the
; signed-in person's spend this month, the held calls and estimates, the spending limits with a row per limit, and the
; spend and tokens over time by mind or model; and the spend alert notice the shell shows elsewhere and one alert's
; details. features/usage/UsageView.tsx loads the lists, states the facts and data (usageScreen.ts, heldCallsScreen.ts,
; limitsScreen.ts, spendAlertDisplay.ts), draws the plan and carries out the presses; the money decisions stay in their
; dialogs (EstimateDialogs.tsx) and a removal asks in the confirm host.
;
; Facts the page states each time it composes:
;   spend alerts (spendAlertDisplay.ts usageAlertFacts): flags alerts.available (the hive reports them) and
;     alerts.action-failed, the value alerts.read (loading, error, empty or ready) and the count alerts.controls (the
;     alerts this viewer may pause or resume); each alert's row composes spend-alert-detail on its own flags alert.open,
;     alert.projection, alert.paused, alert.control and alert.writing; the notice (spend-alert-notice) reads the count
;     alerts.open and the flag alerts.on-usage
;   four resources, each under its own name (screens/resourceFacts.ts): mine (your spend), held (the held calls),
;     limits (the spending limits) and spend (the spend over time): each its value, .stale and .empty, data .error
;   your spend: flags mine.allowance (you have an allowance) and mine.low (under a fifth of it is left, counting what is
;     held); counts mine.minds (minds it went to) and mine.own-keys (your own keys)
;   held calls: counts held.unknown, held.inflight, estimates.open, estimates.more and overruns; flags held.inflight.open
;     (the in-flight row is open) and estimates.several (two or more estimates, so one decision can correct them all)
;   limits: flags limits.adding (the Add a cap form is open), limits.can-set, limits.can-remove-old, limits.hive-cap,
;     limits.hive-all-time, limits.hive.editing (the monthly hive cap's editor is open) and limits.old.others (an old
;     default is on someone else's mind or swarm, theirs to remove); counts limits.people, limits.caps, limits.old and
;     limits.old.mine (the old defaults this viewer may remove)
;   spend: the value spend.view (chart or table), and the flags spend.any (anything was spent in this range or the one
;     before) and sim (the simulator's made-up costs)

(Screen usage "Usage")

(Part usage 1 section ((title "Spend alerts")))
(When usage 1 (on alerts.available))
(Part usage 2 notice ((tone info) (text "Loading spend alerts…")))
(When usage 2 (is alerts.read loading))
(Part usage 3 notice ((tone bad) (text (words "Could not load spend alerts. " (bind alerts.error)))))
(When usage 3 (is alerts.read error))
(Part usage 4 buttons ((items ((button "Try again" reload-spend-alerts ((variant ghost)))))))
(When usage 4 (is alerts.read error))
(Part usage 5 note ((text "No current spend alerts.")))
(When usage 5 (is alerts.read empty))
(Part usage 6 note ((text "Pausing holds new paid calls for the selected scope. Calls already admitted can finish.")))
(When usage 6 (has alerts.controls))
(Part usage 7 notice ((tone bad) (text (bind alerts.action-error))))
(When usage 7 (on alerts.action-failed))
(Part usage 8 stack ((source alerts.rows) (frame card) (label "Current spend alerts")))
(When usage 8 (is alerts.read ready))

; ---------- your spend this month: against your allowance, with what is held, on your own keys, and by mind
(Part usage 100 section ((title "Your spend this month") (body (bind mine.summary))))
(When usage 100 (is mine ready))
(Part usage 110 progress ((source mine.parts)))
(When usage 110 (is mine ready))
(When usage 110 (on mine.allowance))
(Part usage 120 note ((text (words "Mostly: " (bind mine.mostly)))))
(When usage 120 (is mine ready))
(When usage 120 (has mine.minds))
; with an allowance and no key of your own: add one, and while the allowance runs low, ask for more
(Part usage 130 notice ((tone info) (text (bind mine.key.words))))
(When usage 130 (is mine ready))
(When usage 130 (on mine.allowance))
(When usage 130 (none mine.own-keys))
(Part usage 131 buttons ((items ((button "Add a key" add-key ((variant subtle)))))))
(When usage 131 (is mine ready))
(When usage 131 (on mine.allowance))
(When usage 131 (none mine.own-keys))
(Row usage 131 own-key)
(Part usage 132 buttons ((items ((button "Ask for more" ask-more ((variant ghost)))))))
(When usage 132 (is mine ready))
(When usage 132 (on mine.allowance))
(When usage 132 (none mine.own-keys))
(When usage 132 (on mine.low))
(Row usage 132 own-key)

; ---------- held calls: each settles by itself; an estimate may be corrected for 30 days. An admin's list: a member's
; read is refused, and a member sees none of it (forbidden quiet), as on a hive that does not hold calls
(Part usage 200 section ((title "Held calls") (tour held-calls)))
(When usage 200 (none-of ((is held unsupported) (is held forbidden))))
(Part usage 210 note ((text (words (bind held.unknown.n) " outcome unknown · " (bind held.inflight.n) " in flight"))))
(When usage 210 (is held ready))
(Part usage 211 paragraph ((text "When a model call ends without saying what it cost, its worst case stays held against every budget it counts toward until the hive settles it by itself: from OpenRouter’s own record of the call when there is one, otherwise an hour after its outcome went unknown, at its worst case, an upper bound that’s usually lower. You don’t need to do anything. A call settled at its worst case is listed below as an estimate, and you can correct it from the provider’s billing for 30 days.")))
(When usage 211 (none-of ((is held unsupported) (is held forbidden))))
; where the held list is: loading, could not read it, a failed refresh (the shared fragment, orders 212 to 219)
(Resource usage 212 ((name held) (waiting "Loading held calls") (failed "Could not read held costs") (forbidden quiet) (retry reload-held)))
; the held calls, each with how and when it settles
(Part usage 220 empty ((icon coin) (title "Nothing held") (body "Every answered call’s cost is known.")))
(When usage 220 (is held ready))
(When usage 220 (none held.unknown))
(Part usage 221 entries ((source held.unknown) (label "Held calls") (icon icon) (title title) (meta settles)
  (detail reason) (code id)))
(When usage 221 (is held ready))
(When usage 221 (has held.unknown))
; calls still in flight: they settle when they answer, so they wait behind a row that opens
(Part usage 230 disclosure ((title (words "Still in flight (" (bind held.inflight.n) ")")) (meta "these settle themselves when the call answers")
  (expanded held.inflight.open) (action toggle-in-flight)))
(When usage 230 (is held ready))
(When usage 230 (has held.inflight))
(Part usage 231 list ((source held.inflight) (label "Still in flight") (title title) (meta (kind state held_for))))
(When usage 231 (is held ready))
(When usage 231 (has held.inflight))
(When usage 231 (on held.inflight.open))
; estimates a person may still correct: one at a time, or with two or more, all in one decision
(Part usage 240 section ((title "Settled at an estimate")
  (body (words (bind estimates.total) " estimated in total. " (bind estimates.words)))))
(When usage 240 (has estimates.open))
(When usage 240 (none-of ((is held unsupported) (is held forbidden))))
(Part usage 241 actions ((items ((action (words "Correct or release all " (bind estimates.open.n) "…") correct-all)))))
(When usage 241 (has estimates.open))
(When usage 241 (on estimates.several))
(When usage 241 (none-of ((is held unsupported) (is held forbidden))))
(Part usage 242 entries ((source estimates.shown) (label "Settled at an estimate") (icon icon) (title title)
  (badge badge) (meta timing) (detail reason) (code id) (action action) (open correct)))
(When usage 242 (has estimates.open))
(When usage 242 (none-of ((is held unsupported) (is held forbidden))))
(Part usage 243 note ((text (words "and " (bind estimates.more.words) ", all included in Correct all"))))
(When usage 243 (has estimates.more))
(When usage 243 (none-of ((is held unsupported) (is held forbidden))))
; calls that cost more than was held, newest first
(Part usage 250 section ((title "Cost more than was held")))
(When usage 250 (has overruns))
(When usage 250 (none-of ((is held unsupported) (is held forbidden))))
(Part usage 251 list ((source overruns) (label "Cost more than was held") (title title) (summary summary)
  (meta (source_words when))))
(When usage 251 (has overruns))
(When usage 251 (none-of ((is held unsupported) (is held forbidden))))

; ---------- spending limits: the hive cap, each person's monthly allowance, the caps someone set, and old defaults
(Part usage 300 section ((title "Spending limits") (body "Each person spends from their own monthly allowance and the whole hive from its cap. A swarm, mind or key has a cap only if someone sets one. Checked before every paid call, with what is held counted.")))
(Part usage 301 buttons ((items ((button "Add a cap" add-cap ((icon plus) (variant subtle)))))))
(When usage 301 (off limits.adding))
(When usage 301 (on limits.can-set))
(When usage 301 (none-of ((is limits failed) (is limits forbidden) (is limits unsupported))))
; what is left of each plan attached to this hive (features/plans draws it, for the hive owner only)
(Part usage 302 island ((name plan-usage)))
; a new cap: what it applies to, its period (a month for every mind), its figure
(Part usage 303 fields ((submit add-save) (columns two) (items ((field select "Applies to" limits.add.scope ((source limits.add.scopes) (prompt "Choose")))
  (field select "Period" limits.add.period ((source limits.add.periods) (prompt "Choose") (waits limits.add.every-mind)))
  (field number "Limit in dollars" limits.add.limit ((least 0) (step 0.01)))))))
(When usage 303 (on limits.adding))
(Part usage 304 buttons ((items ((button "Cancel" add-cancel ((variant ghost))) (button "Save cap" add-save ((variant primary)))))))
(When usage 304 (on limits.adding))
; where the limits are: loading, admins only, not on this hive, could not load them, a failed refresh (orders 305 to 312)
(Resource usage 305 ((name limits) (waiting "Loading spending limits") (failed-title "Could not load spending limits") (retry reload-limits)
  (unsupported "This hive or the demo does not offer spending limits.") (unsupported-icon ban)
  (part forbidden empty ((icon shield) (title "Admins only") (body "Only admins can see and set spending limits.")))))
; the hive cap, or none yet (with a monthly one to set), and the server's all-time figure until there is a cap
(Part usage 320 section ((title "The hive cap")))
(When usage 320 (is limits ready))
(Part usage 321 stack ((source limits.hive) (frame inset) (label "The hive cap")))
(When usage 321 (is limits ready))
(When usage 321 (on limits.hive-cap))
(Part usage 322 paragraph ((text "No hive cap. A mind with no cap of its own makes no paid calls until there is one.")))
(When usage 322 (is limits ready))
(When usage 322 (off limits.hive-cap))
(Part usage 323 buttons ((items ((button "Set a monthly hive cap" set-hive ((variant subtle)))))))
(When usage 323 (is limits ready))
(When usage 323 (off limits.hive-cap))
(When usage 323 (on limits.can-set))
(When usage 323 (off limits.hive.editing))
(Part usage 324 fields ((submit save-hive) (items ((field number "Limit in dollars" limits.hive.draft ((least 0) (step 0.01) (quiet yes) (focus yes) (placeholder "0.00")))))))
(When usage 324 (is limits ready))
(When usage 324 (off limits.hive-cap))
(When usage 324 (on limits.hive.editing))
(Part usage 325 buttons ((items ((button "Save" save-hive ((variant subtle)))))))
(When usage 325 (is limits ready))
(When usage 325 (off limits.hive-cap))
(When usage 325 (on limits.hive.editing))
(Row usage 324 set-hive)
(Row usage 325 set-hive)
(Part usage 326 stack ((source limits.hive.all-time) (frame inset) (label "The server's figure")))
(When usage 326 (is limits ready))
(When usage 326 (on limits.hive-all-time))
; each person who has signed in, with their monthly allowance
(Part usage 330 section ((title "People")))
(When usage 330 (is limits ready))
(Part usage 331 paragraph ((text "Nobody has signed in yet.")))
(When usage 331 (is limits ready))
(When usage 331 (none limits.people))
(Part usage 332 stack ((source limits.people) (frame inset) (label "People")))
(When usage 332 (is limits ready))
(When usage 332 (has limits.people))
; the caps someone set on a swarm, a mind or a key
(Part usage 340 section ((title "Caps set")))
(When usage 340 (is limits ready))
(Part usage 341 paragraph ((text "No other caps. Add one to hold a swarm, a mind or a key to a figure of its own.")))
(When usage 341 (is limits ready))
(When usage 341 (none limits.caps))
(Part usage 342 stack ((source limits.caps) (frame inset) (label "Caps set")))
(When usage 342 (is limits ready))
(When usage 342 (has limits.caps))
; caps an old form filled in: removed in one action after one confirmation that lists every change, or one at a time
(Part usage 350 section ((title "Old form defaults") (body "These caps look like figures an old form filled in rather than ones someone chose. They still apply until they’re removed.")))
(When usage 350 (is limits ready))
(When usage 350 (has limits.old))
(Part usage 351 buttons ((items ((button (bind limits.old.all) remove-old ((variant subtle)))))))
(When usage 351 (is limits ready))
(When usage 351 (has limits.old))
(When usage 351 (on limits.can-remove-old))
(When usage 351 (has limits.old.mine))
(Part usage 352 entries ((source limits.old) (label "Old form defaults") (title change) (meta reasons) (action action)
  (aria aria) (open remove-old-one)))
(When usage 352 (is limits ready))
(When usage 352 (has limits.old))
; a mind's or swarm's cap is its owner's alone (#704): the rest stay theirs to remove
(Part usage 353 note ((text "A cap on someone else’s mind or swarm is theirs to remove.")))
(When usage 353 (is limits ready))
(When usage 353 (on limits.old.others))

; ---------- spend and tokens over time: one row of filters above everything it scopes, kept at the top
(Part usage 400 segmented ((label "Time range") (bind spend.range) (sticky yes)
  (options ((option "24h" "24h") (option "7d" "7d") (option "30d" "30d")))))
(Part usage 401 segmented ((label "Group by") (bind spend.group) (options ((option agent "Minds") (option model "Models")))))
(Part usage 402 switcher ((label "Show as") (bind spend.view) (options ((option chart "Chart" chart) (option table "Table" table)))))
(Row usage 400 filters)
(Row usage 401 filters)
(Row usage 402 filters)
; where the spend is: loading, or could not load it (orders 403 to 406)
(Resource usage 403 ((name spend) (waiting "Loading usage") (failed-title "Could not load usage")))
(Part usage 410 empty ((icon chart) (title "No usage yet") (body (words "Nothing was spent in the " (bind spend.range.words) ". When minds think, the gateway meters every call here."))))
(When usage 410 (is spend ready))
(When usage 410 (off spend.any))
(Part usage 411 notice ((tone warn) (text (words "Simulated · " (bind sim.note)))))
(When usage 411 (is spend ready))
(When usage 411 (on spend.any))
(When usage 411 (on sim))
(Part usage 420 figures ((label "Key figures") (source spend.figures)))
(When usage 420 (is spend ready))
(When usage 420 (on spend.any))
; as a table: each mind or model's requests, tokens, spend (marked where part is an estimate) and share
(Part usage 430 table ((caption (bind spend.caption)) (source spend.rows) (columns ((column name (bind spend.noun) ())
  (column requests "Requests" ((align end) (tone quiet)))
  (column prompt "Prompt" ((align end) (tone quiet) (phone hide)))
  (column completion "Completion" ((align end) (tone quiet) (phone hide)))
  (column spend "Spend" ((align end) (mark mark) (mark_title mark_title)))
  (column share "Share" ((align end) (tone faint)))))))
(When usage 430 (is spend ready))
(When usage 430 (on spend.any))
(When usage 430 (is spend.view table))
; as charts: spend over time stacked by mind or model, then spend and tokens per mind or model side by side
(Part usage 440 chart ((title (bind spend.chart.title)) (subtitle (bind spend.chart.subtitle)) (chip (bind sim.chip))
  (chip_title (bind sim.note)) (chip_aria "simulated") (source spend.columns) (series spend.series) (axis spend.axis)
  (label "Stacked column chart of spend over time. Show it as a table for the exact values.")))
(When usage 440 (is spend ready))
(When usage 440 (on spend.any))
(When usage 440 (is spend.view chart))
(Part usage 450 bars ((title (bind spend.bars.title)) (subtitle (bind spend.bars.subtitle)) (chip (bind sim.chip))
  (chip_title (bind sim.note)) (chip_aria "simulated") (source spend.bars) (empty "No spend in this range.") (grow yes)))
(When usage 450 (is spend ready))
(When usage 450 (on spend.any))
(When usage 450 (is spend.view chart))
(Part usage 451 bars ((title "Tokens by kind") (subtitle (bind spend.tokens.subtitle)) (source spend.tokens)
  (legend spend.tokens.legend) (grow yes)))
(When usage 451 (is spend ready))
(When usage 451 (on spend.any))
(When usage 451 (is spend.view chart))
(Row usage 450 per-entity)
(Row usage 451 per-entity)

; ---------- one spending limit, as a row of the limits' stacks: who it holds, its figures (pressed to change them when
; it can be changed), the meter of spend and holds against it with its room, and Remove when someone set it.
; Facts each row states (limitsScreen.ts): flags limit.badged, limit.figured (it has figures: a limit, or a person's
; allowance), limit.changeable, limit.editing, limit.removable, limit.holding (calls not yet settled hold some of it)
(Screen usage-limit "A spending limit")
(Part usage-limit 9 line ((title (bind limit.label)) (meta (bind limit.kind)) (orb limit.hue) (orb-size 8) (grow yes)))
(When usage-limit 9 (off limit.badged))
(Part usage-limit 10 line ((title (bind limit.label)) (meta (bind limit.kind)) (badge (bind limit.badge)) (orb limit.hue)
  (orb-size 8) (grow yes)))
(When usage-limit 10 (on limit.badged))
(Part usage-limit 11 buttons ((items ((button (bind limit.figures) edit ((variant ghost)))))))
(When usage-limit 11 (on limit.figured))
(When usage-limit 11 (on limit.changeable))
(When usage-limit 11 (off limit.editing))
(Part usage-limit 12 note ((text (bind limit.figures))))
(When usage-limit 12 (on limit.figured))
(When usage-limit 12 (off limit.changeable))
(Part usage-limit 13 buttons ((items ((button "Set an allowance" edit ((variant ghost)))))))
(When usage-limit 13 (off limit.figured))
(When usage-limit 13 (on limit.changeable))
(When usage-limit 13 (off limit.editing))
(Part usage-limit 14 fields ((submit save) (items ((field number "Limit in dollars" limit.draft ((least 0) (step 0.01) (quiet yes) (focus yes) (placeholder "0.00")))))))
(When usage-limit 14 (on limit.editing))
(Part usage-limit 15 buttons ((items ((button "Save" save ((variant subtle)))))))
(When usage-limit 15 (on limit.editing))
(Part usage-limit 16 buttons ((items ((button "" remove ((aria (bind limit.remove.aria)) (icon x) (variant ghost)))))))
(When usage-limit 16 (on limit.removable))
(When usage-limit 16 (off limit.editing))
(Row usage-limit 9 head)
(Row usage-limit 10 head)
(Row usage-limit 11 head)
(Row usage-limit 12 head)
(Row usage-limit 13 head)
(Row usage-limit 14 head)
(Row usage-limit 15 head)
(Row usage-limit 16 head)
(Part usage-limit 20 progress ((source limit.parts) (text (bind limit.room))))
(When usage-limit 20 (on limit.figured))
(Part usage-limit 21 buttons ((items ((button "See the held calls" see-held ((variant ghost)))))))
(When usage-limit 21 (on limit.figured))
(When usage-limit 21 (on limit.holding))
(Part usage-limit 22 note ((text (bind limit.unset))))
(When usage-limit 22 (off limit.figured))

(Screen spend-alert-notice "Spend alert")
(Part spend-alert-notice 10 bar ((title "Spend alert") (icon alert)
  (items ((button "View Usage" view-spend-alerts ((variant ghost)))))))
(When spend-alert-notice 10 (has alerts.open))
(When spend-alert-notice 10 (none-of ((on alerts.on-usage))))

(Screen spend-alert-detail "Spend alert details")
(Part spend-alert-detail 10 line ((title (bind alert.name)) (badge "Alert active")))
(When spend-alert-detail 10 (on alert.open))
(Part spend-alert-detail 11 line ((title (bind alert.name)) (badge "Alert cleared")))
(When spend-alert-detail 11 (none-of ((on alert.open))))
(Part spend-alert-detail 20 facts ((label "Alert details") (rows ((row "Alert spend" (bind alert.spend))
  (row "Alert window" (bind alert.window)) (row "Opened" (bind alert.opened))))))
(Part spend-alert-detail 21 note ((text (words "Cleared " (bind alert.closed)))))
(When spend-alert-detail 21 (none-of ((on alert.open))))
(Part spend-alert-detail 30 notice ((tone warn) (text (words "At this rate, the hive is projected to spend " (bind alert.projected) " against its " (bind alert.limit) " cap."))))
(When spend-alert-detail 30 (on alert.projection))
(Part spend-alert-detail 40 notice ((tone info) (text "New paid calls for this mind are paused.")))
(When spend-alert-detail 40 (on alert.paused))
(When spend-alert-detail 40 (none-of ((on alert.hive))))
; a hive pause holds the hive’s money alone: a member’s own key is theirs (spend_monitor.HIVE_MONEY)
(Part spend-alert-detail 42 notice ((tone info) (text "New paid calls on the hive’s money are paused. Calls people make on their own keys go on.")))
(When spend-alert-detail 42 (on alert.paused))
(When spend-alert-detail 42 (on alert.hive))
(Part spend-alert-detail 41 note ((text "There is no pause set on this scope.")))
(When spend-alert-detail 41 (none-of ((on alert.paused))))
(Part spend-alert-detail 50 buttons ((items ((button "Pause paid calls" pause ((aria "Pause paid calls for {alert.name}") (variant danger)))))))
(When spend-alert-detail 50 (on alert.control))
(When spend-alert-detail 50 (on alert.open))
(When spend-alert-detail 50 (none-of ((on alert.paused))))
(Part spend-alert-detail 51 buttons ((items ((button "Resume paid calls" resume ((aria "Resume paid calls for {alert.name}") (variant primary)))))))
(When spend-alert-detail 51 (on alert.control))
(When spend-alert-detail 51 (on alert.paused))
(Part spend-alert-detail 52 note ((text "Updating paid call status…")))
(When spend-alert-detail 52 (on alert.writing))
