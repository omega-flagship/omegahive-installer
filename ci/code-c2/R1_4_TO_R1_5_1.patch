+                ('id', 'sequence', 'kind', 'input_bytes', 'input_digest', 'actor')}):
+            _fail('receipt_controls', 'receipt consumed prefix differs from stored controls')
+    reasons = set()
+    if partial_input: reasons.add('submitted_partial_frame')
+    if len(consumed) != len(controls): reasons.add('submitted_controls_not_reported_consumed')
+    if receipt['status'] != 'completed' or run['status'] != 'completed': reasons.add('run_not_reported_completed')
+    if receipt['status'] == 'output_limit' or run['status'] == 'output_limit': reasons.add('output_limit')
+    if len(output) == MAX_LOG: reasons.add('output_at_capture_limit')
