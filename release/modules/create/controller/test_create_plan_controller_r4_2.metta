!(test (na (append (mind-red) ((o 7 piece-started (score t1 composer-7 (mind composer-7))) (o 8 piece-ready (score t1 m1))))) (do (request-review score m1 listening-review)))
!(test (last-rc (append (mind-red) ((o 7 piece-started (score t1 composer-7 (mind composer-7))) (o 8 piece-ready (score t1 m1))
          (o 9 dispatched (v1 review (score m1 listening-review))) (o 10 review-pass (score m1 listening-review ear-1 (render x)))))) (rejected review-needs-evidence))
!(test (pstat score (append (mind-red) ((o 7 piece-started (score t1 composer-7 (mind composer-7))) (o 8 piece-ready (score t1 m1))
          (o 9 dispatched (v1 review (score m1 listening-review))) (o 10 review-pass (score m1 listening-review ear-1 (recording rec1)))))) reviewed)
; a kind with no ReviewFor anywhere makes the plan invalid
!(test (last-rc ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (mind-g) () (nd))))) (rejected no-review-for-artifact-kind))
; a piece producing two kinds needs both reviews
(= (two-g) ((Piece widget (Assignee capability ui-build) (code design) () (w.js w.css))))
(= (two-built) ((o 1 plan-started (op1)) (o 2 planned (op1 (plan1) (two-g) () (nd)))
                (o 3 dispatched (op2 author-tests ref1)) (o 4 tests-authored (op2 suite1))
